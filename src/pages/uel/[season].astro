---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getEuropeanSeasons,
  loadEuropeanLeaguePhaseBySeason,
} from "../../lib/europeanLeaguePhase";
import { loadClubMaster } from "../../lib/clubMaster";
import { hasClubEuropeanMode } from "../../lib/clubCompetitionMode";

import {
  loadCompetitionSchedule,
  filterMatches,
  mdNum,
} from "../../lib/competitionSchedule";
import { getCompetitionSummary } from "../../lib/competitionSummary";
import { getCompetitionPlayerStats } from "../../lib/competitionPlayerStats";
import MatchScheduleTable from "../../components/MatchScheduleTable.astro";

import { loadLeagueMaster } from "../../lib/leagueMaster";
import { loadLeagueStandings } from "../../lib/leagueStandings";

import { loadClubSquads } from "../../lib/clubSquads";

import { getAwards } from "../../lib/competitionAwards";

// ✅ 静的生成
export function getStaticPaths() {
  const seasons = getEuropeanSeasons("UEL").map((s) => String(s).trim());
  return seasons.map((season) => ({ params: { season } }));
}

const season = String(Astro.params.season ?? "").trim();

/* ===== 決勝トーナメント表 ===== */
const bracketSeasons = new Set(["2024-25", "2025-26"]);

const hasTournamentBracket = bracketSeasons.has(season);
const tournamentBracketSrc = `/images/brackets/uel-${season}.svg`;

const rows = loadEuropeanLeaguePhaseBySeason("UEL", season);

const clubMaster = loadClubMaster();
const clubMap = new Map(clubMaster.map((c: any) => [c.club_key, c]));

const leagueMaster = loadLeagueMaster();

const clubSquadRows = loadClubSquads();

const hasDomesticClubPage = (
  leagueKey: string,
  clubKey: string,
  season: string,
) =>
  clubSquadRows.some(
    (r: any) =>
      String(r.league_key ?? "").trim() === leagueKey &&
      String(r.club_key ?? "").trim() === clubKey &&
      String(r.season ?? "").trim() === season,
  );

const leagueLabelMap = new Map(
  leagueMaster
    .filter((r) => r.league_key)
    .map((r) => [
      String(r.league_key).trim(),
      String(r.league_display_ja || r.league_display_en || r.league_key).trim(),
    ]),
);

const leagueLabel = (leagueKey: string) => {
  const key = String(leagueKey ?? "").trim();
  return leagueLabelMap.get(key) || key || "—";
};

const previousSeason = (season: string) => {
  const m = String(season ?? "")
    .trim()
    .match(/^(\d{4})-(\d{2})$/);

  if (!m) return "";

  const startYear = Number(m[1]);

  return `${startYear - 1}-${String(startYear).slice(-2)}`;
};

const previousLeagueSeason = previousSeason(season);

const leagueStandings = loadLeagueStandings();

const standingByClub = new Map(
  leagueStandings
    .filter((r) => r.season === previousLeagueSeason)
    .map((r) => [`${r.league_key}|||${r.club_key}`, r]),
);

const getUelClubLeagueInfo = (r: any) => {
  const clubKey = String(r.club_key ?? "").trim();
  const c: any = clubMap.get(clubKey);

  const leagueKey = String(c?.league_key ?? "").trim();

  const overrideName = String(r.league_name_override ?? "").trim();

  const overrideRank =
    r.league_rank_override != null &&
    Number.isFinite(Number(r.league_rank_override))
      ? Number(r.league_rank_override)
      : null;

  const leagueName = overrideName || leagueLabel(leagueKey);

  const standing = leagueKey
    ? standingByClub.get(`${leagueKey}|||${clubKey}`)
    : undefined;

  const rank = overrideRank ?? (standing?.rank ? Number(standing.rank) : null);

  return {
    leagueKey,
    leagueName,
    rank,
    label: leagueName && rank ? `${leagueName} ${rank}位` : leagueName || "—",
  };
};

const summary = getCompetitionSummary("UEL", season);

const allMatches = loadCompetitionSchedule();

const uelMatches = filterMatches(allMatches, "UEL", season).sort(
  (a: any, b: any) => mdNum(a.md) - mdNum(b.md),
);

const leaguePhaseMatches = uelMatches.filter(
  (r: any) => String(r.stage ?? "").trim() === "League Phase",
);

const opponentMap = new Map<string, Set<string>>();

for (const m of leaguePhaseMatches) {
  const homeKey = String(m.homeKey ?? "").trim();
  const awayKey = String(m.awayKey ?? "").trim();

  if (!homeKey || !awayKey) continue;

  if (!opponentMap.has(homeKey)) {
    opponentMap.set(homeKey, new Set());
  }

  if (!opponentMap.has(awayKey)) {
    opponentMap.set(awayKey, new Set());
  }

  opponentMap.get(homeKey)!.add(awayKey);
  opponentMap.get(awayKey)!.add(homeKey);
}

const knockoutMatches = uelMatches.filter(
  (r: any) => String(r.stage ?? "").trim() !== "League Phase",
);

const goalRank = getCompetitionPlayerStats("UEL", season, "goals");
const assistRank = getCompetitionPlayerStats("UEL", season, "assists");
const topScorer = goalRank[0] ?? null;
const topAssist = assistRank[0] ?? null;

const awards = getAwards("UEL", season);

const majorLeagueOrder = [
  "プレミアリーグ",
  "ラ・リーガ",
  "セリエA",
  "ブンデスリーガ",
  "リーグ・アン",
  "エールディヴィジ",
  "プリメイラ・リーガ",
];

const allLeagueNames = Array.from(
  new Set(
    rows.map((r: any) => getUelClubLeagueInfo(r).leagueName).filter(Boolean),
  ),
);

const majorLeagueNames = majorLeagueOrder.filter((name) =>
  allLeagueNames.includes(name),
);

const hasOtherLeagues = allLeagueNames.some(
  (name) => !majorLeagueOrder.includes(name),
);

const leagueNames = [
  ...majorLeagueNames,
  ...(hasOtherLeagues ? ["その他"] : []),
];

const clubHrefByKey = (clubKey: string) => {
  const key = String(clubKey ?? "").trim();
  const c: any = clubMap.get(key);

  if (!c) return "";

  const leagueKey = String(c.league_key ?? "").trim();
  if (!leagueKey) return "";

  if (
    hasClubEuropeanMode({
      competition: "UEL",
      season,
      leagueKey,
      clubKey: key,
    })
  ) {
    return (
      `/uel/${encodeURIComponent(season)}` + `/club/${encodeURIComponent(key)}/`
    );
  }

  // UELクラブページが未生成ならリンクを付けない
  return "";
};

const clubDisplay = (clubKey: string, fallback = "") => {
  const c: any = clubMap.get(String(clubKey));
  return (
    c?.club_display_ja ||
    c?.name_ja ||
    c?.club_name_en ||
    fallback ||
    clubKey ||
    "—"
  );
};

// ===== UEL公式表彰＋選手成績 =====

const normAwardName = (v: unknown) =>
  String(v ?? "")
    .trim()
    .replace(/　/g, " ")
    .replace(/\s+/g, " ");

const awardRows = awards.map((award) => {
  const candidates = clubSquadRows.filter(
    (r: any) =>
      String(r.season ?? "").trim() === season &&
      String(r.club_key ?? "").trim() === award.team &&
      normAwardName(r.name_ja) === normAwardName(award.player),
  );

  // UEFA成績が入力されたレコードを優先。
  // 同条件なら冬のスナップショットを優先。
  const squad =
    [...candidates].sort((a: any, b: any) => {
      const score = (r: any) =>
        ["uefa_apps", "uefa_starts", "uefa_goals", "uefa_assists"].filter(
          (key) => String(r[key] ?? "").trim() !== "",
        ).length;

      return (
        score(b) - score(a) ||
        Number(b.window === "winter") - Number(a.window === "winter")
      );
    })[0] ?? null;

  return {
    ...award,
    squad,
    clubName: clubDisplay(award.team),
    clubHref: clubHrefByKey(award.team),
  };
});

const hasAwardStats = awardRows.some(
  (r) => r.squad && String(r.squad.uefa_apps ?? "").trim() !== "",
);

const awardStat = (value: unknown) => {
  const s = String(value ?? "").trim();
  return s === "" ? "－" : s;
};

const fmt = (v: any) => ((v ?? v === 0) ? String(v) : "—");

const updated = rows[0]?.updated_at
  ? String(rows[0].updated_at).replaceAll("-", "/")
  : "—";

const title = `UEFAヨーロッパリーグ ${season}｜組み合わせ・出場クラブ・順位表・日程結果｜海外サッカーDB`;

// under-title に “シーズンピル” を出す
const seasons = getEuropeanSeasons("UEL")
  .map((s) => String(s).trim())
  .sort()
  .reverse();

const championHref = summary?.champion_club_key
  ? clubHrefByKey(summary.champion_club_key)
  : "";

const runnerUpHref = summary?.runner_up_club_key
  ? clubHrefByKey(summary.runner_up_club_key)
  : "";
---

<BaseLayout
  title={title}
  description={title}
  bodyClass="page-uel"
  bodyStyle="margin:0; font-family: system-ui; background-color: #f5cba7;"
  showPageHeader={true}
  crumbs={[
    { label: "トップ", href: "/" },
    { label: "UEFA EL", href: "/uel/" },
    { label: season },
  ]}
  heading=""
>
  <h1 class="page-title">
    UEFAヨーロッパリーグ {season} 大会ポータル
  </h1>

  <p class="lead">
    UEFAヨーロッパリーグ（EL）{
      season
    }シーズンの抽選結果・組み合わせ、出場クラブ、リーグフェーズ順位表、日程・結果、決勝トーナメント、得点・アシストランキングをまとめた大会ポータルページです。
  </p>

  <div class="pill-block">
    <div class="pill-label">🔎 シーズンを切り替える</div>

    <div class="pills">
      {
        seasons.map((s) => (
          <a
            class={`pill ${s === season ? "is-active" : ""}`}
            href={`/uel/${encodeURIComponent(s)}/`}
          >
            <span class="dot" aria-hidden="true" />
            {s}
          </a>
        ))
      }

      <a class="pill" href="/uel/">
        <span class="dot" aria-hidden="true"></span>シーズン一覧
      </a>
    </div>
  </div>

  <div class="pill-block">
    <div class="pill-label">📑 ページ内の各項目へ移動</div>

    <nav class="pills" aria-label="ページ内ナビゲーション">
      <a class="pill" href="#summary">🏆 大会サマリー</a>
      <a class="pill" href="#clubs">⚽ 出場クラブ</a>
      <a class="pill" href="#league-phase-schedule">🏟 LP日程・結果</a>
      <a class="pill" href="#league-phase">📊 LP順位表</a>
      <a class="pill" href="#schedule">🏟 KP日程・結果</a>

      {
        hasTournamentBracket && (
          <a class="pill" href="#tournament-bracket">
            🏆 トーナメント表
          </a>
        )
      }

      {
        (goalRank.length > 0 || assistRank.length > 0) && (
          <a class="pill" href="#rankings">
            🥇 得点・アシスト
          </a>
        )
      }

      {
        awards.length > 0 && (
          <a class="pill" href="#awards">
            🏅 大会表彰
          </a>
        )
      }
    </nav>
  </div>

  <section id="summary" class="summaryBox">
    <h2>🏆 大会サマリー</h2>

    <div class="summaryGrid">
      <div>
        <span>形式</span>
        <b
          >{
            summary?.format_type === "league_phase"
              ? "リーグフェーズ(LP) ⇒ ノックアウトフェーズ(KP)"
              : summary?.format_type || "—"
          }</b
        >
      </div>

      <div>
        <span>優勝</span>
        <b>
          {
            summary?.champion_club_key ? (
              championHref ? (
                <a href={championHref}>
                  {clubDisplay(summary.champion_club_key)}
                </a>
              ) : (
                clubDisplay(summary.champion_club_key)
              )
            ) : (
              "未定"
            )
          }
        </b>
      </div>

      <div>
        <span>準優勝</span>
        <b>
          {
            summary?.runner_up_club_key ? (
              runnerUpHref ? (
                <a href={runnerUpHref}>
                  {clubDisplay(summary.runner_up_club_key)}
                </a>
              ) : (
                clubDisplay(summary.runner_up_club_key)
              )
            ) : (
              "未定"
            )
          }
        </b>
      </div>

      <div>
        <span>得点王</span>
        <b>
          {
            topScorer
              ? `${topScorer.player_name} (${topScorer.team_name_ja})`
              : "—"
          }
        </b>
      </div>

      <div>
        <span>アシスト王</span>
        <b>
          {
            topAssist
              ? `${topAssist.player_name} (${topAssist.team_name_ja})`
              : "—"
          }
        </b>
      </div>
    </div>
  </section>

  <section id="clubs">
    <h2>⚽ リーグフェーズ(LP) 出場クラブ一覧</h2>
    <div class="filter-line">
      <div class="filter-label">🔎 ポットで絞り込み</div>

      <div class="pills" id="uel-pot-pills">
        <button class="pill clear is-active" type="button" data-pot="">
          <span class="dot"></span>全て
        </button>

        {
          [1, 2, 3, 4].map((pot) => (
            <button
              class={`pill pot-filter pot-${pot}`}
              type="button"
              data-pot={String(pot)}
            >
              <span class="dot" />
              ポット{pot}
            </button>
          ))
        }
      </div>
    </div>
    <div class="filter-line">
      <div class="filter-label">🔎 所属リーグで絞り込み</div>
      <div class="pills" id="uel-league-pills">
        <button class="pill clear is-active" type="button" data-league="">
          <span class="dot"></span>全て
        </button>
        {
          leagueNames.map((name) => (
            <button class="pill" type="button" data-league={name}>
              <span class="dot" />
              {name}
            </button>
          ))
        }
      </div>
    </div>

    <div class="uel-opponent-status" id="uel-opponent-status" hidden>
      <span id="uel-opponent-status-text" class="uel-focus-action"></span>

      <button
        type="button"
        id="uel-jump-to-schedule"
        class="uel-focus-action uel-focus-button"
      >
        ↓ 日程・結果へジャンプ
      </button>

      <button type="button" id="uel-opponent-clear"> 選択をリセット </button>
    </div>

    <div class="team-grid" id="uel-club-grid">
      {
        rows.map((r: any) => {
          const clubKey = String(r.club_key ?? "").trim();
          const c: any = clubMap.get(clubKey);
          const leagueInfo = getUelClubLeagueInfo(r);
          const league = leagueInfo.leagueName;
          const leagueFilter = majorLeagueOrder.includes(league)
            ? league
            : "その他";
          const pot =
            r.pot != null && Number.isFinite(Number(r.pot))
              ? String(r.pot)
              : "";

          const href = clubKey ? clubHrefByKey(clubKey) : "";
          const name = r.club_name_raw || clubDisplay(clubKey);
          const opponentKeys = clubKey
            ? [...(opponentMap.get(clubKey) ?? [])]
            : [];
          return (
            <div
              class="team-card"
              data-uel-club-card
              data-club-key={clubKey}
              data-opponents={opponentKeys.join("|")}
              data-league={leagueFilter}
              data-pot={pot}
            >
              <div class="row1">
                <div class="name">{name}</div>
              </div>

              <div class="meta">
                <span class={`badge pot-badge ${pot ? `pot-${pot}` : ""}`}>
                  {pot ? `ポット${pot}` : "ポット —"}
                </span>

                <span class="badge">{leagueInfo.label}</span>
              </div>

              <div class="team-card-actions">
                {href ? (
                  <a class="team-card-link" href={href}>
                    👕選手一覧
                  </a>
                ) : (
                  <span class="team-card-link is-disabled">👕選手一覧</span>
                )}

                <button
                  type="button"
                  class="team-card-opponents"
                  data-uel-opponents-button
                  data-club-key={clubKey}
                  disabled={!clubKey}
                >
                  🔎 対戦相手
                </button>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <section id="league-phase-schedule">
    <h2>🏟 リーグフェーズ(LP) 日程・結果</h2>

    <div class="uel-lp-filter-status" id="uel-lp-filter-status" hidden>
      <span id="uel-lp-filter-status-text" class="uel-focus-action"></span>

      <button
        type="button"
        id="uel-jump-to-clubs"
        class="uel-focus-action uel-focus-button"
      >
        ↑ 出場クラブ一覧へ戻る
      </button>

      <button type="button" id="uel-lp-filter-clear"> 選択をリセット </button>
    </div>

    <MatchScheduleTable
      matches={leaguePhaseMatches}
      heading={`UEL ${season} リーグフェーズ`}
      showMatchLinks={false}
    />
  </section>

  <section id="league-phase">
    <h2>📊 リーグフェーズ(LP)順位表</h2>
    <div class="uel-meta">
      <span>クラブ数：{rows.length}</span>
      <span>更新：{updated}</span>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th style="text-align:center;">クラブ</th>
            <th>試</th><th>勝</th><th>分</th><th>敗</th>
            <th>得</th><th>失</th><th>差</th><th>点</th>
            <th>枠</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r: any) => {
              const clubKey = String(r.club_key ?? "").trim();
              const href = clubKey ? clubHrefByKey(clubKey) : "";
              return (
                <tr>
                  <td>{fmt(r.rank)}</td>
                  <td class="left">
                    {href ? (
                      <a class="club-link" href={href}>
                        {r.club_name_raw ?? r.club_key}
                      </a>
                    ) : (
                      (r.club_name_raw ?? "—")
                    )}
                  </td>
                  <td>{fmt(r.played)}</td>
                  <td>{fmt(r.won)}</td>
                  <td>{fmt(r.draw)}</td>
                  <td>{fmt(r.lost)}</td>
                  <td>{fmt(r.gf)}</td>
                  <td>{fmt(r.ga)}</td>
                  <td>{fmt(r.gd)}</td>
                  <td>{fmt(r.pts)}</td>
                  <td>
                    <span class="pill small">{fmt(r.qualified)}</span>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <p class="note">
      ※ 上位8クラブはラウンド16へ。9～24位の16クラブはKOフェーズ進出をかけてPO
    </p>
  </section>

  <section id="schedule">
    <h2>🏟 ノックアウトフェーズ(KP) 日程・結果</h2>
    <MatchScheduleTable
      matches={knockoutMatches}
      heading={`UEL ${season} 決勝トーナメント`}
      showMatchLinks={false}
    />
  </section>

  {
    hasTournamentBracket && (
      <section id="tournament-bracket" class="uel-bracket-section">
        <h2>🏆 ノックアウトフェーズ(KP) 決勝トーナメント表</h2>

        <p class="note uel-bracket-note">
          ラウンド16以降の組み合わせ、2戦合計スコア、決勝までの勝ち上がりを一覧で確認できます。
        </p>

        <div class="tournament-bracket-wrap">
          <img
            class="tournament-bracket-image"
            src={tournamentBracketSrc}
            alt={`UEFAヨーロッパリーグ ${season} 決勝トーナメント表`}
            loading="lazy"
          />
        </div>

        <p class="tournament-bracket-open">
          <a href={`/uel/${season}/bracket/`} target="_blank" rel="noopener">
            トーナメント表を大きく表示する →
          </a>
        </p>
      </section>
    )
  }

  <section id="rankings">
    <h2>🥇 得点・アシストランキング</h2>

    <div class="rank-grid">
      <div class="rank-card">
        <h3>得点ランキング</h3>
        {
          goalRank.length === 0 ? (
            <p class="note">データ準備中です。</p>
          ) : (
            <table class="rank">
              <thead>
                <tr>
                  <th>順位</th>
                  <th>選手</th>
                  <th>クラブ</th>
                  <th class="num">得点</th>
                </tr>
              </thead>
              <tbody>
                {goalRank.map((r: any) => (
                  <tr>
                    <td>{r.rank}</td>
                    <td>{r.player_name}</td>
                    <td>
                      {(() => {
                        const teamKey = String(r.team_key ?? "").trim();
                        const href = teamKey ? clubHrefByKey(teamKey) : "";
                        const label = r.team_name_ja || clubDisplay(teamKey);

                        return href ? (
                          <a class="club-link" href={href}>
                            {label}
                          </a>
                        ) : (
                          <span>{label}</span>
                        );
                      })()}
                    </td>
                    <td class="num">
                      <b>{r.goals || "—"}</b>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )
        }
      </div>

      <div class="rank-card">
        <h3>アシストランキング</h3>
        {
          assistRank.length === 0 ? (
            <p class="note">データ準備中です。</p>
          ) : (
            <table class="rank">
              <thead>
                <tr>
                  <th>順位</th>
                  <th>選手</th>
                  <th>クラブ</th>
                  <th class="num">アシスト</th>
                </tr>
              </thead>
              <tbody>
                {assistRank.map((r: any) => (
                  <tr>
                    <td>{r.rank}</td>
                    <td>{r.player_name}</td>
                    <td>
                      {(() => {
                        const teamKey = String(r.team_key ?? "").trim();
                        const href = teamKey ? clubHrefByKey(teamKey) : "";
                        const label = r.team_name_ja || clubDisplay(teamKey);

                        return href ? (
                          <a class="club-link" href={href}>
                            {label}
                          </a>
                        ) : (
                          <span>{label}</span>
                        );
                      })()}
                    </td>
                    <td class="num">
                      <b>{r.assists || "—"}</b>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )
        }
      </div>
    </div>
  </section>

  {
    awards.length > 0 && (
      <section id="awards" class="uel-awards-section">
        <h2>⚽ UEFAヨーロッパリーグ {season} 表彰</h2>

        <p class="note">
          UEFA公式の個人賞・チーム・オブ・ザ・シーズンを掲載しています。
        </p>

        <div class="uel-awards-table-wrap">
          <table class="uel-awards-table">
