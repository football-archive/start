---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  buildBallonDorWinnerRows,
} from "../../../lib/ballonDor";

const heading = "バロンドール歴代受賞者一覧";
const title = "バロンドール歴代受賞者一覧";
const description =
  "バロンドールの歴代受賞者を年度別に掲載。受賞者の国籍、ポジション、所属クラブ、主要大会から各年の順位・候補者・得票数一覧へ移動できます。";

const rows = buildBallonDorWinnerRows();
---

<BaseLayout
  title={title}
  description={description}
  bodyClass="page-awards page-ballon-dor-index"
  bodyStyle="margin:0; font-family: system-ui;"
  showPageHeader={true}
  crumbs={[{ label: "トップ", href: "/" }, { label: "バロンドール" }]}
  heading={heading}
>
  <h1>バロンドール歴代受賞者一覧</h1>

  <p class="award-lead">
    世界年間最優秀選手に贈られるバロンドールの歴代受賞者一覧です。各年度を選択すると、その年の順位・候補者・所属クラブ・主要大会・得票数を確認できます。
  </p>

  <section class="award-section" aria-labelledby="winner-list-heading">
    <div class="section-heading-row">
      <div>
        <p class="section-kicker">BALLON D'OR</p>
        <h2 id="winner-list-heading">歴代受賞者</h2>
      </div>
      <p class="section-note">新しい年度から掲載</p>
    </div>

    {
      rows.length ? (
        <div class="table-scroll">
          <table class="award-table">
            <thead>
              <tr>
                <th class="col-year">年</th>
                <th class="col-player">受賞者</th>
                <th class="col-nationality">国籍</th>
                <th class="col-position">Pos</th>
                <th class="col-club">所属クラブ</th>
                <th class="col-competition">主要大会</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr class:list={[row.isCancelled && "is-cancelled"]}>
                  <td class="year-cell">
                    <a href={row.href}>{row.year}</a>
                  </td>
                  <td class="player-cell">
                    <a href={row.href}>{row.playerName || "－"}</a>
                    {row.statusLabel && row.status !== "completed" && (
                      <small class="status-label">{row.statusLabel}</small>
                    )}
                  </td>
                  <td>{row.nationality || "－"}</td>
                  <td class="position-cell">{row.position || "－"}</td>
                  <td>
                    {row.clubs.length ? (
                      <span class="stacked-links">
                        {row.clubs.map((club) =>
                          club.href ? (
                            <a href={club.href}>{club.name}</a>
                          ) : (
                            <span>{club.name}</span>
                          ),
                        )}
                      </span>
                    ) : (
                      "－"
                    )}
                  </td>
                  <td>
                    {row.competitions.length ? (
                      <span class="stacked-links">
                        {row.competitions.map((competition) =>
                          competition.href ? (
                            <a href={competition.href}>{competition.label}</a>
                          ) : (
                            <span>{competition.label}</span>
                          ),
                        )}
                      </span>
                    ) : (
                      "－"
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty-message">公開中の年度データはありません。</p>
      )
    }
  </section>

  <p class="award-note">
    得票数の表記や選考対象期間は年度によって異なります。詳しくは各年のページをご確認ください。
  </p>

  <style>
    h1 {
      margin: 18px 0 10px;
      font-size: clamp(24px, 4vw, 34px);
      line-height: 1.3;
    }

    .award-lead {
      max-width: 850px;
      margin: 0 0 24px;
      color: #444;
      line-height: 1.8;
    }

    .award-section {
      margin-top: 18px;
      padding: 18px;
      border: 1px solid color-mix(in srgb, var(--theme-color) 35%, #e6e6e6);
      border-radius: 14px;
      background: color-mix(in srgb, var(--theme-color) 5%, #fff);
    }

    .section-heading-row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 14px;
    }

    .section-kicker {
      margin: 0 0 3px;
      color: color-mix(in srgb, var(--theme-color) 78%, #5b4300);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 0.14em;
    }

    h2 {
      margin: 0;
      font-size: 22px;
    }

    .section-note {
      margin: 0;
      color: #777;
      font-size: 12px;
    }

    .table-scroll {
      overflow-x: auto;
      border: 1px solid #dedede;
      border-radius: 10px;
      background: #fff;
    }

    .award-table {
      width: 100%;
      min-width: 800px;
      border-collapse: collapse;
      font-size: 14px;
    }

    .award-table th,
    .award-table td {
      padding: 11px 10px;
      border-bottom: 1px solid #e8e8e8;
      vertical-align: top;
      text-align: left;
    }

    .award-table th {
      background: var(--theme-table-head-bg);
      border-bottom-color: var(--theme-table-head-border);
      font-size: 12px;
      font-weight: 800;
      white-space: nowrap;
    }

    .award-table tbody tr:last-child td {
      border-bottom: 0;
    }

    .award-table tbody tr:hover {
      background: color-mix(in srgb, var(--theme-color) 5%, #fff);
    }

    .award-table a {
      color: color-mix(in srgb, var(--theme-color) 72%, #5a4300);
      font-weight: 700;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }

    .col-year,
    .year-cell {
      width: 66px;
      text-align: center !important;
      white-space: nowrap;
    }

    .col-position,
    .position-cell {
      width: 50px;
      text-align: center !important;
      white-space: nowrap;
    }

    .player-cell > a {
      display: inline-block;
      font-weight: 900;
    }

    .status-label {
      display: block;
      margin-top: 3px;
      color: #777;
      font-size: 11px;
      font-weight: 600;
    }

    .stacked-links {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .is-cancelled {
      color: #777;
      background: #fafafa;
    }

    .award-note {
      margin: 14px 2px 0;
      color: #666;
      font-size: 12px;
      line-height: 1.7;
    }

    .empty-message {
      margin: 0;
      padding: 16px;
      color: #666;
    }

    @media (max-width: 700px) {
      .award-section {
        padding: 12px;
      }

      .section-heading-row {
        align-items: flex-start;
        flex-direction: column;
        gap: 4px;
      }

      .award-table {
        font-size: 13px;
      }

      .award-table th,
      .award-table td {
        padding: 9px 8px;
      }
    }
  </style>
</BaseLayout>
