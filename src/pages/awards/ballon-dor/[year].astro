---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  buildBallonDorYearPage,
  formatAwardPoints,
  getBallonDorYears,
} from "../../../lib/ballonDor";
import { awardUrl, type Year } from "../../../lib/urls";

export function getStaticPaths() {
  return getBallonDorYears().map((year) => ({ params: { year } }));
}

const year = String(Astro.params.year ?? "").trim();
const page = buildBallonDorYearPage(year);

if (!page) {
  return Astro.redirect("/awards/ballon-dor/");
}

const parentHref = "/awards/ballon-dor/";
const title = `${year}年 バロンドール順位・候補者・得票数一覧`;
const description = `${year}年バロンドールの順位、候補者、得票数、国籍、ポジション、所属クラブ、主要大会を一覧で掲載しています。`;

const formatDate = (value: string) => {
  const raw = String(value ?? "").trim();
  if (!raw) return "";

  const match = raw.match(/^(\d{4})-(\d{2})-(\d{2})$/);

  return match
    ? `${match[1]}年${Number(match[2])}月${Number(match[3])}日`
    : raw;
};

const splitNationality = (value: string) =>
  String(value ?? "")
    .split("/")
    .map((item) => item.trim())
    .filter(Boolean);

const periodLabel = (() => {
  const start = formatDate(page.edition?.period_start ?? "");
  const end = formatDate(page.edition?.period_end ?? "");

  if (start && end) return `${start}～${end}`;

  return start || end;
})();

const prevHref = page.previousYear
  ? awardUrl({
      awardKey: "ballon-dor",
      year: page.previousYear as Year,
    })
  : "";

const nextHref = page.nextYear
  ? awardUrl({
      awardKey: "ballon-dor",
      year: page.nextYear as Year,
    })
  : "";
---

<BaseLayout
  title={title}
  description={description}
  bodyClass="page-awards page-ballon-dor-year"
  bodyStyle="margin:0; font-family: system-ui;"
  showPageHeader={true}
  crumbs={[
    { label: "トップ", href: "/" },
    { label: "表彰", href: "/awards/" },
    { label: "バロンドール", href: parentHref },
    { label: `${year}年` },
  ]}
  heading={title}
>
  <h1>{year}年 バロンドール順位・候補者・得票数一覧</h1>

  <p class="award-lead">
    {
      year
    }年バロンドールの順位・候補者・得票数一覧。</br>
ノミネートされた各選手の所属クラブ（当時）、国籍、ポジション、関連主要大会を掲載しています。
  </p>

  {
    page.edition?.update_date && (
      <p class="update-date">
        更新日：
        <time datetime={page.edition.update_date}>
          {formatDate(page.edition.update_date)}
        </time>
      </p>
    )
  }

  <section class="edition-summary" aria-label={`${year}年大会情報`}>
    <dl>
      {
        page.statusLabel && (
          <div>
            <dt>ステータス</dt>
            <dd>{page.statusLabel}</dd>
          </div>
        )
      }

      {
        periodLabel && (
          <div>
            <dt>選考対象期間</dt>
            <dd>{periodLabel}</dd>
          </div>
        )
      }

      {
        page.edition?.ceremony_date && (
          <div>
            <dt>授賞式</dt>
            <dd>{formatDate(page.edition.ceremony_date)}</dd>
          </div>
        )
      }
    </dl>

    {page.edition?.notes && <p class="edition-note">{page.edition.notes}</p>}
  </section>

  {
    page.isCancelled ? (
      <section class="cancelled-panel">
        <h2>開催中止</h2>
        <p>
          {page.edition?.notes ||
            `${year}年のバロンドールは開催されませんでした。`}
        </p>
      </section>
    ) : page.candidates.length ? (
      <section class="award-section" aria-labelledby="candidate-list-heading">
        <div class="section-heading-row">
          <div>
            <p class="section-kicker">BALLON D'OR {year}</p>
            <h2 id="candidate-list-heading">候補者一覧</h2>
          </div>

          <p class="section-note">※2010～2014年は得票率</p>
        </div>

        <nav
          class="year-navigation year-navigation-top"
          aria-label="バロンドール年度ナビゲーション（表上部）"
        >
          <div class="nav-side nav-prev">
            {nextHref ? <a href={nextHref}>← {page.nextYear}年へ</a> : <span />}
          </div>

          <a class="nav-index" href={parentHref}>
            歴代受賞者一覧へ
          </a>

          <div class="nav-side nav-next">
            {prevHref ? (
              <a href={prevHref}>{page.previousYear}年へ →</a>
            ) : (
              <span />
            )}
          </div>
        </nav>

        <div class="table-scroll">
          <table class="award-table">
            <thead>
              <tr>
                <th class="col-rank">順位</th>
                <th class="col-player">選手</th>
                <th class="col-position">Pos</th>
                <th class="col-club">所属クラブ（当時）</th>
                <th class="col-nationality">国籍</th>
                <th class="col-competition">関連主要大会</th>
                <th class="col-points">得票数</th>
              </tr>
            </thead>

            <tbody>
              {page.candidates.map((candidate) => {
                const nationalities = splitNationality(candidate.nationality);

                return (
                  <tr>
                    <td class="rank-cell">{candidate.rank || "－"}</td>

                    <td class="player-cell">
                      <strong>{candidate.playerName}</strong>

                      {candidate.notes && <small>{candidate.notes}</small>}
                    </td>

                    <td class="position-cell">{candidate.position || "－"}</td>

                    <td class="club-cell">
                      {candidate.clubs.length ? (
                        <span class="stacked-links club-links">
                          {candidate.clubs.map((club) =>
                            club.href ? (
                              <a href={club.href}>{club.name}</a>
                            ) : (
                              <span>{club.name}</span>
                            ),
                          )}
                        </span>
                      ) : (
                        "－"
                      )}
                    </td>

                    <td class="nationality-cell">
                      {nationalities.length ? (
                        <span class="nationality-stack">
                          {nationalities.map((nationality) => (
                            <span>{nationality}</span>
                          ))}
                        </span>
                      ) : (
                        "－"
                      )}
                    </td>

                    <td class="competition-cell">
                      {candidate.competitions.length ? (
                        <span class="competition-list">
                          {candidate.competitions.map((competition) => (
                            <span class="competition-item">
                              <span class="competition-name">
                                {competition.label}
                              </span>

                              {competition.href && competition.country && (
                                <a
                                  class="competition-team"
                                  href={competition.href}
                                >
                                  {competition.country}代表
                                </a>
                              )}
                            </span>
                          ))}
                        </span>
                      ) : (
                        "－"
                      )}
                    </td>

                    <td class="points-cell">
                      {formatAwardPoints(candidate.points)}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    ) : (
      <section class="empty-panel">
        <h2>{page.statusLabel || "候補者一覧"}</h2>
        <p>発表があり次第、掲載します。</p>
      </section>
    )
  }

  <nav
    class="year-navigation year-navigation-bottom"
    aria-label="バロンドール年度ナビゲーション（表下部）"
  >
    <div class="nav-side nav-prev">
      {nextHref ? <a href={nextHref}>← {page.nextYear}年へ</a> : <span />}
    </div>

    <a class="nav-index" href={parentHref}>歴代受賞者一覧へ</a>

    <div class="nav-side nav-next">
      {prevHref ? <a href={prevHref}>{page.previousYear}年へ →</a> : <span />}
    </div>
  </nav>

  <style>
    h1 {
      margin: 18px 0 10px;
      font-size: clamp(26px, 4vw, 36px);
      line-height: 1.3;
    }

    .award-lead {
      max-width: 900px;
      margin: 0;
      color: #444;
      font-size: 16px;
      line-height: 1.8;
    }

    .update-date {
      margin: 7px 0 16px;
      font-size: 14px;
      font-weight: 700;
      text-align: right;
    }

    .update-date time {
      color: #c62828;
      font-weight: 800;
    }

    .edition-summary {
      margin: 0 0 20px;
      padding: 16px 18px;
      border: 1px solid #ddd;
      border-radius: 12px;
      background: #fafafa;
    }

    .edition-summary dl {
      display: flex;
      flex-wrap: wrap;
      gap: 11px 30px;
      margin: 0;
    }

    .edition-summary dl > div {
      display: flex;
      align-items: baseline;
      gap: 9px;
    }

    .edition-summary dt {
      color: #666;
      font-size: 13px;
      font-weight: 800;
    }

    .edition-summary dd {
      margin: 0;
      font-size: 15px;
      font-weight: 800;
    }

    .edition-note {
      margin: 13px 0 0;
      padding-top: 13px;
      border-top: 1px solid #e3e3e3;
      font-size: 15px;
      line-height: 1.75;
    }

    .award-section {
      padding: 18px;
      border: 1px solid color-mix(in srgb, var(--theme-color) 35%, #e6e6e6);
      border-radius: 14px;
      background: color-mix(in srgb, var(--theme-color) 5%, #fff);
    }

    .section-heading-row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 12px;
    }

    .section-kicker {
      margin: 0 0 3px;
      color: color-mix(in srgb, var(--theme-color) 78%, #5b4300);
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 0.14em;
    }

    h2 {
      margin: 0;
      font-size: 24px;
    }

    .section-note {
      margin: 0;
      color: #555;
      font-size: 13px;
      font-weight: 700;
    }

    .table-scroll {
      overflow-x: auto;
      border: 1px solid #dedede;
      border-radius: 10px;
      background: #fff;
    }

    .award-table {
      width: 100%;
      min-width: 830px;
      border-collapse: collapse;
      font-size: 15px;
    }

    .award-table th,
    .award-table td {
      padding: 12px 10px;
      border-bottom: 1px solid #e8e8e8;
      vertical-align: top;
      text-align: left;
    }

    .award-table th {
      background: var(--theme-table-head-bg);
      border-bottom-color: var(--theme-table-head-border);
      font-size: 14px;
      font-weight: 900;
      white-space: nowrap;
    }

    .award-table tbody tr:last-child td {
      border-bottom: 0;
    }

    .award-table tbody tr:hover {
      background: color-mix(in srgb, var(--theme-color) 5%, #fff);
    }

    .col-rank,
    .rank-cell {
      width: 58px;
      text-align: center !important;
      white-space: nowrap;
      font-weight: 800;
    }

    .col-position,
    .position-cell {
      width: 52px;
      text-align: center !important;
      white-space: nowrap;
    }

    .col-points,
    .points-cell {
      width: 82px;
      text-align: right !important;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
      font-weight: 800;
    }

    .col-player {
      min-width: 190px;
    }

    .col-club {
      min-width: 150px;
    }

    .col-nationality {
      min-width: 115px;
    }

    .col-competition {
      min-width: 110px;
    }

    .player-cell strong {
      display: block;
      font-size: 15px;
      line-height: 1.45;
    }

    .player-cell small {
      display: block;
      margin-top: 4px;
      color: color-mix(in srgb, var(--theme-color) 86%, #644900);
      font-size: 13px;
      font-weight: 700;
      line-height: 1.5;
    }

    .stacked-links,
    .nationality-stack {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 3px;
    }

    .club-links a {
      color: #2e7d32;
      font-weight: 800;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }

    .club-links a:hover {
      color: #1b5e20;
    }

    .competition-links a {
      color: #8b1e3f;
      font-weight: 800;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }

    .competition-links a:hover {
      color: #61122b;
    }

    .nationality-stack {
      line-height: 1.35;
    }

    .cancelled-panel,
    .empty-panel {
      padding: 22px;
      border: 1px solid #ddd;
      border-radius: 12px;
      background: #fafafa;
    }

    .cancelled-panel p,
    .empty-panel p {
      margin-bottom: 0;
      font-size: 15px;
      line-height: 1.8;
    }

    .year-navigation {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 14px;
    }

    .year-navigation-top {
      margin: 0 0 15px;
    }

    .year-navigation-bottom {
      margin: 24px 0 4px;
    }

    .year-navigation a {
      display: inline-block;
      padding: 9px 13px;
      border: 1px solid #d8d8d8;
      border-radius: 999px;
      background: #fff;
      color: #333;
      font-size: 14px;
      font-weight: 800;
      text-decoration: none;
    }

    .year-navigation a:hover {
      border-color: var(--theme-color);
    }

    .nav-next {
      text-align: right;
    }

    .nav-index {
      text-align: center;
    }

    @media (max-width: 700px) {
      .award-lead {
        font-size: 15px;
      }

      .update-date {
        font-size: 13px;
      }

      .edition-summary dl {
        display: grid;
        gap: 9px;
      }

      .edition-summary dt {
        font-size: 13px;
      }

      .edition-summary dd {
        font-size: 14px;
      }

      .award-section {
        padding: 12px;
      }

      .section-heading-row {
        align-items: flex-start;
        flex-direction: column;
        gap: 5px;
      }

      .award-table {
        font-size: 14px;
      }

      .award-table th {
        font-size: 13px;
      }

      .award-table th,
      .award-table td {
        padding: 10px 8px;
      }

      .player-cell small {
        font-size: 12px;
      }

      .year-navigation {
        grid-template-columns: 1fr 1fr;
      }

      .nav-index {
        grid-column: 1 / -1;
        grid-row: 1;
        justify-self: center;
      }

      .nav-prev {
        grid-column: 1;
        grid-row: 2;
      }

      .nav-next {
        grid-column: 2;
        grid-row: 2;
      }
    }

    .competition-list {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }

    .competition-item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }

    .competition-name {
      color: #333;
      font-weight: 700;
    }

    .competition-team {
      color: #8b1e3f;
      font-size: 13px;
      font-weight: 800;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }
  </style>
</BaseLayout>
