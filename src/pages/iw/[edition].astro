---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getIwMonthly } from "../../lib/iwMonthly";
import { publishedIwEditions } from "../../lib/iwPublishedEditions";
import { parseCsv } from "../../lib/csvSimple";
import fs from "node:fs";
import path from "node:path";

// 月別ハブと国別IW導線で公開対象月を共有します。
const editions = publishedIwEditions;

export function getStaticPaths() {
  return publishedIwEditions.map((edition) => ({
    params: { edition },
  }));
}
const edition = Astro.params.edition!;
const year = edition.slice(0, 4);
const month = Number(edition.slice(4, 6));
const period = `${year}年${month}月`;
const title = `${period} 代表ウィーク 国際Aマッチ 日程・結果`;
const { matches } = getIwMonthly(edition);
const dates = [...new Set(matches.map((m) => m.date))];
const confeds = [
  { id: "ALL", label: "すべて" },
  { id: "AFC", label: "AFC" },
  { id: "UEFA", label: "UEFA" },
  { id: "CAF", label: "CAF" },
  { id: "CONMEBOL", label: "CONMEBOL" },
  { id: "CONCACAF", label: "CONCACAF" },
  { id: "OFC", label: "OFC" },
];
const countryNames = [
  ...new Set(matches.flatMap((m) => [m.homeName, m.awayName])),
]
  .filter(Boolean)
  .sort((a, b) => a.localeCompare(b, "ja"));

// 既存の国別IWページと同様、callups_siteのsnapshot_dateを更新日の根拠にします。
const callups = parseCsv(
  fs.readFileSync(
    path.join(process.cwd(), "src/data/callups_site.csv"),
    "utf8",
  ),
) as Record<string, string>[];
const latestSnapshot =
  callups
    .filter(
      (r) =>
        String(r.competition ?? "")
          .trim()
          .toUpperCase() === "IW" && String(r.edition ?? "").trim() === edition,
    )
    .map((r) =>
      String(r.snapshot_date ?? "")
        .trim()
        .replaceAll("/", "-"),
    )
    .filter((s) => /^\d{4}-\d{1,2}-\d{1,2}$/.test(s))
    .map((s) => {
      const [y, m, d] = s.split("-");
      return `${y}-${m.padStart(2, "0")}-${d.padStart(2, "0")}`;
    })
    .sort()
    .at(-1) ?? "";
const updatedLabel = latestSnapshot
  ? `${latestSnapshot.slice(0, 4)}年${Number(latestSnapshot.slice(5, 7))}月${Number(latestSnapshot.slice(8, 10))}日`
  : "";
const editionLabel = (v: string) =>
  `${v.slice(0, 4)}年${Number(v.slice(4, 6))}月`;
---

<BaseLayout
  title={title}
  description={`${period}のサッカー各国代表戦・国際Aマッチの日程と結果を掲載。アジア・欧州・南米・アフリカなど大陸別、国別に試合を検索でき、各国の招集メンバー・背番号も確認できます。`}
  bodyClass="page-wc"
  showPageHeader={true}
  heading={`${period} 代表ウィーク`}
  crumbs={[
    { label: "トップ", href: "/" },
    { label: "各国代表", href: "/nt/" },
    { label: title },
  ]}
>
  <main class="iw-monthly">
    <h1>{title}</h1>
    <p class="lead">
      当サイトで収録している国際Aマッチの日程・結果を掲載。
      大陸・国名で試合を絞り込めます。
      国名リンクから活動期間の招集メンバー一覧へ移動できます。<br />
      ※日付は参照元に準拠しており、時差補正は行っていません。
    </p>
    {
      updatedLabel && (
        <p class="iw-updated">
          更新日：<span>{updatedLabel}</span>
        </p>
      )
    }

    <nav class="month-nav" aria-label="代表ウィークの月切替">
      <span class="nav-label">代表ウィーク</span>
      <div class="pills">
        {
          editions.map((e) => (
            <a
              class:list={["pill", { active: e === edition }]}
              href={`/iw/${e}/`}
              aria-current={e === edition ? "page" : undefined}
            >
              {editionLabel(e)}
            </a>
          ))
        }
      </div>
    </nav>

    <div class="filters">
      <div class="filter-row">
        <span class="filter-label" id="confed-label">大陸で絞り込み</span>
        <div class="pills" role="group" aria-labelledby="confed-label">
          {
            confeds.map((c) => (
              <button
                type="button"
                class:list={["pill", "confed-pill", { active: c.id === "ALL" }]}
                data-confed={c.id}
                aria-pressed={c.id === "ALL"}
              >
                {c.label}
              </button>
            ))
          }
        </div>
      </div>
      <div class="filter-row country-row">
        <label class="filter-label" for="country">国から探す</label>
        <select id="country"
          ><option value="ALL">すべての国</option>{
            countryNames.map((n) => <option value={n}>{n}</option>)
          }</select
        >
        <span class="match-count" id="count" aria-live="polite"
          >{matches.length}試合</span
        >
      </div>
    </div>

    <div id="match-list">
      {
        dates.map((date) => (
          <section class="match-day" data-date={date}>
            <h2>{date}</h2>
            {matches
              .filter((m) => m.date === date)
              .map((m) => (
                <article
                  class="match"
                  data-confeds={m.confeds.join(" ")}
                  data-home={m.homeName}
                  data-away={m.awayName}
                >
                  <div class="scoreline">
                    <div class="team left">
                      {m.homeUrl ? (
                        <a href={m.homeUrl}>{m.homeName}</a>
                      ) : (
                        <span>{m.homeName}</span>
                      )}
                    </div>
                    <strong>{m.score}</strong>
                    <div class="team">
                      {m.awayUrl ? (
                        <a href={m.awayUrl}>{m.awayName}</a>
                      ) : (
                        <span>{m.awayName}</span>
                      )}
                    </div>
                  </div>
                  {m.note && <div class="note">{m.note}</div>}
                </article>
              ))}
          </section>
        ))
      }
    </div>
    <p id="empty" hidden>該当する試合はありません。</p>
    <p class="footnote">
      対象：当サイトで収録している国際Aマッチの日程・結果を掲載。
      国名リンクから活動期間の招集メンバー一覧ページへ移動できます。
      <br />※日付は参照元に準拠しており、時差補正は行っていません。
    </p>
  </main>
  <script>
    let selectedConfed = "ALL";
    const country = document.querySelector<HTMLSelectElement>("#country");
    const count = document.querySelector<HTMLElement>("#count");
    const empty = document.querySelector<HTMLElement>("#empty");
    const pills = [
      ...document.querySelectorAll<HTMLButtonElement>(".confed-pill"),
    ];
    const apply = () => {
      const selectedCountry = country?.value ?? "ALL";
      let total = 0;
      document.querySelectorAll<HTMLElement>(".match-day").forEach((day) => {
        let visible = 0;
        day.querySelectorAll<HTMLElement>(".match").forEach((match) => {
          const regionMatch =
            selectedConfed === "ALL" ||
            (match.dataset.confeds ?? "").split(" ").includes(selectedConfed);
          const countryMatch =
            selectedCountry === "ALL" ||
            match.dataset.home === selectedCountry ||
            match.dataset.away === selectedCountry;
          const show = regionMatch && countryMatch;
          match.hidden = !show;
          if (show) {
            total++;
            visible++;
          }
        });
        day.hidden = visible === 0;
      });
      if (count) count.textContent = `${total}試合`;
      if (empty) empty.hidden = total !== 0;
      pills.forEach((p) => {
        const active = p.dataset.confed === selectedConfed;
        p.classList.toggle("active", active);
        p.setAttribute("aria-pressed", String(active));
      });
    };
    pills.forEach((p) =>
      p.addEventListener("click", () => {
        selectedConfed = p.dataset.confed ?? "ALL";
        apply();
      }),
    );
    country?.addEventListener("change", apply);
    apply();
  </script>
</BaseLayout>
<style>
  .iw-monthly {
    max-width: 920px;
    margin: 0 auto;
    padding: 20px 16px 48px;
  }
  .iw-monthly h1 {
    font-size: 1.55rem;
    margin: 0 0 12px;
  }
  .lead,
  .footnote {
    color: #586574;
    line-height: 1.75;
    font-size: 0.9rem;
  }
  .iw-updated {
    text-align: right;
    font-size: 15px;
    margin: 8px 0 16px;
  }
  .iw-updated span {
    color: #c62828;
    font-weight: 600;
  }
  .month-nav {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    margin: 20px 0 14px;
  }
  .nav-label,
  .filter-label {
    font-weight: 700;
    font-size: 0.92rem;
  }
  .pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .pill {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--theme-soft-border);
    border-radius: 999px;
    background: #fff;
    color: var(--theme-color);
    padding: 7px 13px;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.25;
    text-decoration: none;
    cursor: pointer;
    transition:
      background 0.15s,
      border-color 0.15s;
  }
  .pill:hover {
    background: var(--theme-soft-bg);
  }
  .pill.active {
    background: var(--theme-color);
    border-color: var(--theme-color);
    color: #fff;
  }
  .filters {
    margin: 18px 0;
    padding: 14px;
    background: color-mix(in srgb, var(--theme-color) 6%, white);
    border-radius: 9px;
  }
  .filter-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .filter-row + .filter-row {
    margin-top: 14px;
  }
  .country-row select {
    padding: 8px 12px;
    border: 1px solid #bdc8d4;
    border-radius: 6px;
    background: white;
    max-width: 100%;
    min-width: 175px;
  }
  .match-count {
    margin-left: auto;
    color: #526071;
    font-size: 0.85rem;
  }
  .match-day {
    margin: 24px 0;
  }
  .match-day h2 {
    font-size: 1.05rem;
    padding: 10px 12px;
    background: var(--theme-soft-bg);
    border-left: 4px solid var(--theme-color);
    border-radius: 4px;
  }
  .match {
    border-bottom: 1px solid #e4e8ed;
    padding: 12px 4px;
  }
  .scoreline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 70px minmax(0, 1fr);
    gap: 8px;
    align-items: center;
  }
  .scoreline strong {
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .team {
    min-width: 0;
  }
  .team.left {
    text-align: right;
  }
  .team a {
    color: var(--theme-link);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .team a:hover {
    text-decoration-thickness: 2px;
  }
  .note {
    text-align: center;
    font-size: 0.78rem;
    color: #718093;
    margin-top: 5px;
  }
  .footnote {
    margin-top: 24px;
  }
  #empty {
    text-align: center;
    padding: 30px;
    color: #586574;
  }
  [hidden] {
    display: none !important;
  }
  @media (max-width: 540px) {
    .scoreline {
      grid-template-columns: minmax(0, 1fr) 52px minmax(0, 1fr);
      font-size: 0.88rem;
    }
    .iw-monthly {
      padding: 16px 10px;
    }
    .filters {
      padding: 12px;
    }
    .country-row select {
      min-width: 150px;
    }
  }
</style>
