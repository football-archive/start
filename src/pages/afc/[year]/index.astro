---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { loadGroups, getGroupsList } from "../../../lib/tournamentGroups";
import MatchScheduleTable from "../../../components/MatchScheduleTable.astro";
import {
  loadCompetitionSchedule,
  filterMatches,
  mdNum,
} from "../../../lib/competitionSchedule";
import fs from "node:fs";
import path from "node:path";
import { parseCsv } from "../../../lib/csvSimple";
import {
  getGoalRanking,
  getAssistRanking,
  getEventTeamCount,
  addRank,
} from "../../../lib/matchEvents";
import { getAwards } from "../../../lib/competitionAwards";
import { loadCallups } from "../../../lib/callups";
import { fmtJP } from "../../../lib/updates";
import { toYMD } from "../../../lib/rosterFormat";

const editions = [
  { year: "2027", label: "2027" },
  { year: "2023", label: "2023" },
  { year: "2019", label: "2019" },
  { year: "2015", label: "2015" },
];

export function getStaticPaths() {
  return [
    { params: { year: "2027" } },
    { params: { year: "2023" } },
    { params: { year: "2019" } },
    { params: { year: "2015" } },
  ];
}

const year = Astro.params.year;
const matches = filterMatches(
  loadCompetitionSchedule(),
  "AFC",
  String(year),
).sort((a, b) => mdNum(a.md) - mdNum(b.md));
const groupRows = loadGroups("AFC", year);
const groups = getGroupsList(groupRows);

// WCと同じグループ別データ構造
const groupSets: Record<
  string,
  {
    name: string;
    is_placeholder: boolean;
  }[]
> = {};

const standingsByGroup = new Map<string, any[]>();

for (const r of groupRows as any[]) {
  const g = String(r.group ?? "").trim();
  if (!g) continue;

  const name = String(r.country_name_ja || r.country_key || "").trim();

  if (!groupSets[g]) groupSets[g] = [];

  if (name) {
    groupSets[g].push({
      name,
      is_placeholder: String(r.is_placeholder ?? "0") === "1",
    });
  }

  if (!standingsByGroup.has(g)) {
    standingsByGroup.set(g, []);
  }
  standingsByGroup.get(g)!.push(r);
}

// WCと同じ順位・スロット順
for (const list of standingsByGroup.values()) {
  list.sort((a, b) => {
    const ra = Number(a.rank ?? 0);
    const rb = Number(b.rank ?? 0);
    if (ra && rb) return ra - rb;
    return Number(a.slot ?? 999) - Number(b.slot ?? 999);
  });
}

const teams = groupRows
  .filter((r: any) => String(r.is_placeholder ?? "0") !== "1")
  .map((r: any) => ({
    name: String(r.country_name_ja ?? "").trim(),
    key: String(r.country_key ?? "").trim(),
    route: String(r.route_param || r.country_key || "").trim(),
    group: String(r.group ?? "").trim(),
    slot: Number(r.slot ?? 999),
  }))
  .filter((t) => t.name && t.route)
  .sort((a, b) => a.group.localeCompare(b.group) || a.slot - b.slot);

const readCsv = (fileName: string) =>
  parseCsv(
    fs.readFileSync(path.join(process.cwd(), "src", "data", fileName), "utf-8"),
  ) as Record<string, string>[];

const countryMaster = readCsv("country_master.csv");

const metaSlugs = new Set(
  readCsv("nt_tournament_meta.csv")
    .map((r) => String(r.team_slug ?? "").trim())
    .filter(Boolean),
);

const callupCountries = new Set(
  readCsv("callups_site.csv")
    .map((r) => String(r.country ?? "").trim())
    .filter(Boolean),
);

const ntSlugByCountryName = new Map(
  countryMaster
    .filter(
      (r) =>
        metaSlugs.has(String(r.country_key ?? "").trim()) ||
        callupCountries.has(String(r.country_name_ja ?? "").trim()),
    )
    .map((r) => [
      String(r.country_name_ja ?? "").trim(),
      String(r.country_key ?? "").trim(),
    ]),
);

// AFCアジアカップの得点・アシストランキング
// AFCアジアカップの得点・アシストランキング
const goalRanking = addRank(getGoalRanking("AFC", String(year)), "goals");

const assistRanking = addRank(getAssistRanking("AFC", String(year)), "assists");

const eventTeamCount = getEventTeamCount("AFC", String(year));
const awardRowsRaw = getAwards("AFC", String(year));

const normalizeAwardMatchText = (value: unknown) =>
  String(value ?? "")
    .trim()
    .replace(/　/g, " ")
    .replace(/\s+/g, " ");

const makeAwardCallupKey = (player: unknown) => normalizeAwardMatchText(player);

// AFCの当該大会に登録された代表メンバー
const afcCallups = (loadCallups() as any[]).filter(
  (r) =>
    String(r.competition ?? "").trim() === "AFC" &&
    String(r.edition ?? "").trim() === String(year),
);

// 当該AFC大会の選手一覧ページが存在する国
const afcRosterCountries = new Set(
  afcCallups.map((r) => String(r.country ?? "").trim()).filter(Boolean),
);

// AFC大会ページ優先 → 国ハブへフォールバック
const getCountryHref = (country: string): string | null => {
  const name = String(country ?? "").trim();

  if (afcRosterCountries.has(name)) {
    return `/afc/${year}/team/${encodeURIComponent(name)}/`;
  }

  const ntSlug = ntSlugByCountryName.get(name);

  return ntSlug ? `/nt/${encodeURIComponent(ntSlug)}/` : null;
};

// AFC当該大会の代表メンバー最終更新日（WC準拠）
const latestCallupSnapshotRaw = afcCallups.reduce((max: string, r: any) => {
  const s = toYMD(String(r.snapshot_date ?? ""));
  if (!s) return max;
  return !max || s > max ? s : max;
}, "");

const latestCallupSnapshot = latestCallupSnapshotRaw
  ? fmtJP(latestCallupSnapshotRaw)
  : "";

// ===== AFC 最終メンバー発表国（WC準拠） =====
const finalizedCountrySet = new Set(
  afcCallups
    .filter((r: any) => {
      const text = [r.note, r.notes, r.memo, r.status, r.comment, r.remarks]
        .map((v) => String(v ?? ""))
        .join(" ");

      return text.includes("最終メンバー");
    })
    .map((r: any) => String(r.country ?? "").trim())
    .filter(Boolean),
);

const finalizedCountries = Array.from(finalizedCountrySet).sort((a, b) =>
  a.localeCompare(b, "ja"),
);

const makeAwardKey = (team: unknown, player: unknown) =>
  `${normalizeAwardMatchText(team)}|||${normalizeAwardMatchText(player)}`;

const callupByAwardKey = new Map<string, any>();

for (const r of afcCallups) {
  const key = makeAwardKey(r.country, r.name_ja);
  if (normalizeAwardMatchText(r.name_ja)) {
    callupByAwardKey.set(key, r);
  }
}

const goalByAwardKey = new Map<string, number>();
for (const r of goalRanking) {
  goalByAwardKey.set(makeAwardKey(r.team, r.player), Number(r.goals));
}

const assistByAwardKey = new Map<string, number>();
for (const r of assistRanking) {
  assistByAwardKey.set(makeAwardKey(r.team, r.player), Number(r.assists));
}

const hasAwardStats =
  afcCallups.some((r) => String(r.apps ?? "").trim() !== "") ||
  goalRanking.length > 0 ||
  assistRanking.length > 0;

const awardRows = awardRowsRaw.map((award) => {
  const key = makeAwardKey(award.team, award.player);

  return {
    ...award,
    callup: callupByAwardKey.get(key) ?? null,
    goals: goalByAwardKey.get(key),
    assists: assistByAwardKey.get(key),
  };
});

const v = (x: unknown) => String(x ?? "").trim() || "-";
---

<BaseLayout
  title={`AFCアジアカップ${year} 出場国・代表メンバー一覧・日程・グループ`}
  description={`AFCアジアカップ${year}の出場24か国、各国代表メンバー・背番号、グループ組み合わせ、試合日程・結果、順位表、決勝トーナメント表を掲載。`}
  bodyClass="page-afc"
>
  <main>
    <h1>AFCアジアカップ{year} 大会ポータルページ</h1>

    <p class="afc-lead">
      AFCアジアカップ{year}の出場国一覧と各国代表の情報を掲載。
      🔥この1ページで大会全体を俯瞰することができます。
    </p>

    <p class="quick-title">
      出場24か国・試合日程・グループ勝敗表・決勝トーナメント表をまとめて確認できます。
      {
        latestCallupSnapshot ? (
          <span class="update-date">｜最終更新：{latestCallupSnapshot}</span>
        ) : null
      }
    </p>

    {
      finalizedCountries.length > 0 && (
        <div class="afc-final-summary">
          <strong>📢 最終メンバー掲載国：</strong>{" "}
          {finalizedCountries.map((country, idx) => {
            const href = getCountryHref(country);

            return (
              <>
                {idx > 0 ? "・" : ""}
                {href ? <a href={href}>{country}</a> : <span>{country}</span>}
              </>
            );
          })}
        </div>
      )
    }

    <div class="afc-page-nav">
      <p class="quick-title">⚽ このページで確認できる内容</p>
      <nav class="afc-page-nav-links" aria-label="ページ内ナビゲーション">
        <a href="#schedule">日程・結果</a>
        <a href="#knockout">決勝トーナメント表</a>
        <a href="#groups">グループ勝敗表</a>
        <a href="#teams">出場国一覧</a>
        <a href="#rankings">得点ランキング</a>
        <a href="#awards">大会表彰</a>
      </nav>
    </div>

    <p class="quick-title">🔍 大会を切り替える</p>
    <nav class="afc-editions" aria-label="AFCアジアカップ開催年">
      {
        editions.map((edition) => (
          <a
            href={`/afc/${edition.year}/`}
            class:list={[
              "afc-edition-pill",
              { "is-active": String(year) === edition.year },
            ]}
            aria-current={String(year) === edition.year ? "page" : undefined}
          >
            {edition.label}
          </a>
        ))
      }
    </nav>

    <section id="teams" class="afc-teams">
      <h2>⚽ AFCアジアカップ{year} 出場国一覧</h2>
      <p>出場24か国をグループ別に確認できます。</p>

      <div class="afc-filterbar">
        <div class="afc-filter-row">
          <input
            id="afc-team-search"
            type="search"
            placeholder="国名で検索"
            aria-label="出場国を検索"
          />
          <span>表示：<b id="afc-team-count">{teams.length}</b>か国</span>
        </div>

        <div class="afc-group-filter">
          <span class="afc-filter-label">🔍 グループ</span>

          <div class="afc-pills" id="afc-group-pills">
            <button type="button" class="afc-pill is-active" data-group="">
              全
            </button>
            {
              groups.map((g) => (
                <button type="button" class="afc-pill" data-group={g}>
                  {g}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div class="afc-team-grid">
        {
          teams.map((team) => {
            const href = getCountryHref(team.name);

            const content = (
              <>
                <strong>{team.name}</strong>
                <span class="afc-team-meta">
                  <span class="afc-team-badge">grp {team.group}</span>
                  {finalizedCountrySet.has(team.name) && (
                    <span class="afc-team-badge is-final">最終</span>
                  )}
                </span>
              </>
            );

            return href ? (
              <a
                class="afc-team-card"
                href={href}
                data-afc-team
                data-name={team.name}
                data-group={team.group}
              >
                {content}
              </a>
            ) : (
              <div
                class="afc-team-card is-disabled"
                data-afc-team
                data-name={team.name}
                data-group={team.group}
              >
                {content}
              </div>
            );
          })
        }
      </div>

      <p id="afc-teams-empty" hidden>該当する国がありません。</p>
    </section>

    <script is:inline>
      (() => {
        const root = document.querySelector("#teams");
        if (!root) return;

        const search = root.querySelector("#afc-team-search");
        const buttons = [...root.querySelectorAll(".afc-pill")];
        const cards = [...root.querySelectorAll("[data-afc-team]")];
        const count = root.querySelector("#afc-team-count");
        const empty = root.querySelector("#afc-teams-empty");

        let group = new URLSearchParams(location.search).get("group") || "";

        function render() {
          const query = (search.value || "").trim().toLowerCase();
          let visible = 0;

          for (const card of cards) {
            const matchesGroup = !group || card.dataset.group === group;
            const matchesName = (card.dataset.name || "")
              .toLowerCase()
              .includes(query);

            const show = matchesGroup && matchesName;
            card.hidden = !show;
            if (show) visible++;
          }

          count.textContent = String(visible);
          empty.hidden = visible !== 0;

          for (const button of buttons) {
            const active = button.dataset.group === group;
            button.classList.toggle("is-active", active);
            button.setAttribute("aria-pressed", String(active));
          }
        }

        search.addEventListener("input", render);

        for (const button of buttons) {
          button.addEventListener("click", () => {
            group = button.dataset.group || "";
            const url = new URL(location.href);

            if (group) url.searchParams.set("group", group);
            else url.searchParams.delete("group");

            history.replaceState(
              null,
              "",
              url.pathname + url.search + "#teams",
            );
            render();
          });
        }

        window.addEventListener("popstate", () => {
          group = new URLSearchParams(location.search).get("group") || "";
          render();
        });

        render();
      })();
    </script>

    <section id="schedule" style="margin: 18px 0;">
      <h2>⚽ AFCアジアカップ{year} 日程・試合結果</h2>
      <p class="quick-title" style="margin: 6px 0 10px;">
        AFCアジアカップ{year}の全試合の日程・結果を掲載しています。
        試合時刻は発表後に更新します。
      </p>

      <MatchScheduleTable
        matches={matches}
        heading={`AFC${year} 日程・結果`}
        showMatchLinks={false}
      />
    </section>

    <section id="groups" style="margin: 18px 0;">
      <h2>⚽ AFCアジアカップ{year} グループ勝敗表</h2>

      <p class="quick-title" style="margin: 6px 0 10px;">
        AFCアジアカップ{year}の各グループ参加国と勝敗表を掲載しています。
      </p>

      <div class="group-grid">
        {
          groups.map((g) => (
            <div class="group-card">
              <h3>Group {g}</h3>

              <ul>
                {(groupSets[g] || []).map((it) => (
                  <li>
                    {it.is_placeholder ? (
                      <span class="placeholder">{it.name}</span>
                    ) : getCountryHref(it.name) ? (
                      <a href={getCountryHref(it.name)!}>{it.name}</a>
                    ) : (
                      <span>{it.name}</span>
                    )}
                  </li>
                ))}
              </ul>

              {(() => {
                const s = standingsByGroup.get(g) || [];
                if (s.length === 0) return null;

                return (
                  <div class="group-standings-wrap">
                    <table
                      class="mini-standings"
                      aria-label={`Group ${g} standings`}
                    >
                      <thead>
                        <tr>
                          <th>国</th>
                          <th>試</th>
                          <th>勝</th>
                          <th>分</th>
                          <th>負</th>
                          <th>得</th>
                          <th>失</th>
                          <th>差</th>
                          <th>点</th>
                        </tr>
                      </thead>
                      <tbody>
                        {s.map((r) => (
                          <tr>
                            <td>
                              {String(r.is_placeholder ?? "0") === "1" ? (
                                <span class="placeholder">
                                  {r.country_name_ja}
                                </span>
                              ) : getCountryHref(
                                  String(r.country_name_ja ?? "").trim(),
                                ) ? (
                                <a
                                  href={
                                    getCountryHref(
                                      String(r.country_name_ja ?? "").trim(),
                                    )!
                                  }
                                >
                                  {r.country_name_ja}
                                </a>
                              ) : (
                                <span>{r.country_name_ja}</span>
                              )}
                            </td>
                            <td>{v(r.played)}</td>
                            <td>{v(r.w)}</td>
                            <td>{v(r.d)}</td>
                            <td>{v(r.l)}</td>
                            <td>{v(r.gf)}</td>
                            <td>{v(r.ga)}</td>
                            <td>{v(r.gd)}</td>
                            <td>
                              <b>{v(r.pts)}</b>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                );
              })()}
            </div>
          ))
        }
      </div>
    </section>

    <section id="knockout" class="afc-knockout">
      <h2>🏆 AFCアジアカップ{year} 決勝トーナメント</h2>

      <p class="quick-title">
        ベスト16から決勝までの組み合わせ・勝ち上がりを掲載しています。
      </p>

      <div class="afc-bracket-wrap">
        <img
          src={`/images/brackets/afc-${year}.svg`}
          alt={`AFCアジアカップ${year} 決勝トーナメント表`}
          loading="lazy"
        />
      </div>

      <p class="afc-bracket-open">
        <a
          href={`/images/brackets/afc-${year}.svg`}
          target="_blank"
          rel="noopener noreferrer"
        >
          トーナメント表を大きく表示する →
        </a>
      </p>
    </section>

    <section id="rankings" class="afc-ranking">
      <h2>⚽ AFCアジアカップ{year} 得点・アシストランキング</h2>

      <p class="quick-title" style="margin: 6px 0 10px;">
        AFCアジアカップ{
          year
        }の得点・アシストを試合結果から随時更新していきます。
      </p>

      <div class="afc-ranking-grid">
        <div class="afc-rank-card">
          <h3>🥇 得点ランキング</h3>

          {
            goalRanking.length === 0 ? (
              <p class="rank-muted">大会前、またはデータ準備中です。</p>
            ) : (
              <table
                class="afc-ranking-table"
                aria-label={`AFC${year} goal ranking`}
              >
                <thead>
                  <tr>
                    <th>順位</th>
                    <th>選手</th>
                    <th>国</th>
                    <th>得点</th>
                  </tr>
                </thead>
                <tbody>
                  {goalRanking.slice(0, 200).map((r) => {
                    const countryHref = getCountryHref(r.team);

                    return (
                      <tr>
                        <td>
                          <b>{r.rank}</b>
                        </td>
                        <td>{r.player}</td>
                        <td>
                          {countryHref ? (
                            <a href={countryHref}>{r.team}</a>
                          ) : (
                            <span>{r.team}</span>
                          )}
                        </td>
                        <td>
                          <b>{r.goals}</b>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            )
          }
        </div>

        <div class="afc-rank-card">
          <h3>🎯 アシストランキング</h3>

          {
            assistRanking.length === 0 ? (
              <p class="rank-muted">大会前、またはデータ準備中です。</p>
            ) : (
              <table
                class="afc-ranking-table"
                aria-label={`AFC${year} assist ranking`}
              >
                <thead>
                  <tr>
                    <th>順位</th>
                    <th>選手</th>
                    <th>国</th>
                    <th>アシスト</th>
                  </tr>
                </thead>
                <tbody>
                  {assistRanking.slice(0, 200).map((r) => {
                    const countryHref = getCountryHref(r.team);

                    return (
                      <tr>
                        <td>
                          <b>{r.rank}</b>
                        </td>
                        <td>{r.player}</td>
                        <td>
                          {countryHref ? (
                            <a href={countryHref}>{r.team}</a>
                          ) : (
                            <span>{r.team}</span>
                          )}
                        </td>
                        <td>
                          <b>{r.assists}</b>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            )
          }
        </div>
      </div>
    </section>

    <section id="awards" class="afc-awards" style="margin: 18px 0;">
      <h2>⚽ AFCアジアカップ{year} 表彰</h2>

      <p class="quick-title" style="margin: 6px 0 10px;">
        AFCアジアカップ{
          year
        }の個人賞・ベストイレブンなど各表彰を掲載しています。
      </p>

      {
        awardRows.length === 0 ? (
          <p class="rank-muted">発表され次第、更新します。</p>
        ) : (
          <div class="awards-table-wrap">
            <table
              class="awards-table"
              aria-label={`AFCアジアカップ${year} 大会表彰`}
            >
              <thead>
                <tr>
                  <th>賞</th>
                  <th>選手</th>
                  <th>国</th>

                  {hasAwardStats && (
                    <>
                      <th class="num">出場</th>
                      <th class="num">G</th>
                      <th class="num">A</th>
                    </>
                  )}
                </tr>
              </thead>

              <tbody>
                {awardRows.map((r) => {
                  const callup = r.callup;
                  const countryHref = getCountryHref(r.team);

                  return (
                    <tr>
                      <td>
                        <b>{r.award_name}</b>
                        {r.note ? (
                          <span class="award-note">{r.note}</span>
                        ) : null}
                      </td>

                      <td>
                        <b>{r.player}</b>
                        {callup?.position_primary ? (
                          <span class="award-pos">
                            （{callup.position_primary}）
                          </span>
                        ) : null}
                      </td>

                      <td>
                        {countryHref ? (
                          <a href={countryHref}>{r.team}</a>
                        ) : (
                          <span>{r.team}</span>
                        )}
                      </td>

                      {hasAwardStats && (
                        <>
                          <td class="num">
                            {String(callup?.apps ?? "").trim()
                              ? `${callup.apps}${
                                  String(callup.starts ?? "").trim()
                                    ? `（先発${callup.starts}）`
                                    : ""
                                }`
                              : "－"}
                          </td>
                          <td class="num">{r.goals ?? "－"}</td>
                          <td class="num">{r.assists ?? "－"}</td>
                        </>
                      )}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }
    </section>
