---
import BaseLayout from "../../../../layouts/BaseLayout.astro";

import { loadClubMaster } from "../../../../lib/clubMaster";
import { loadLeagueMaster } from "../../../../lib/leagueMaster";

import {
  loadCtSeasonMeta,
  findCtSeasonMeta,
  isCtSeasonMetaUcl,
} from "../../../../lib/ctSeasonMeta";

import {
  loadUclLeaguePhaseAll,
  hasUclLeaguePhaseClub,
} from "../../../../lib/ucl";

import {
  loadClubSquads,
  sortClubRoster,
  applyClubStatsMode,
} from "../../../../lib/clubSquads";

import RosterView from "../../../../components/RosterView.astro";
import { buildClubColumns } from "../../../../lib/rosterColumns";
import { toYMD } from "../../../../lib/rosterFormat";

import { loadCallups } from "../../../../lib/callups";
import {
  buildRepLabelFromCallups,
  buildRepHistoryLinksFromCallups,
} from "../../../../lib/repCandidate";

import { seasonShort } from "../../../../lib/seasonFormat";

import { hasClubUclMode } from "../../../../lib/clubCompetitionMode";

import fs from "node:fs";
import path from "node:path";
import { parseCsv } from "../../../../lib/csvSimple";

// --------------------
// getStaticPaths
// ct_season_meta = CL
// ＋ ucl_league_phase に存在
// の両方を満たすページだけ生成
// --------------------
export async function getStaticPaths() {
  const metaRows = loadCtSeasonMeta();

  const targets = metaRows.filter((meta) => {
    const season = String(meta.season ?? "").trim();
    const leagueKey = String(meta.league_key ?? "").trim();
    const clubKey = String(meta.club_key ?? "").trim();

    return hasClubUclMode({
      season,
      leagueKey,
      clubKey,
    });
  });

  return targets.map((meta) => ({
    params: {
      season: meta.season,
      club_key: meta.club_key,
    },
    props: {
      league_key: meta.league_key,
    },
  }));
}

const season = String(Astro.params.season ?? "").trim();
const club_key = String(Astro.params.club_key ?? "").trim();

const { league_key } = Astro.props as {
  league_key: string;
};

const clubMaster = loadClubMaster();
const leagueMaster = loadLeagueMaster();

const clubInfo = clubMaster.find(
  (c) => String(c.club_key ?? "").trim() === club_key,
);

const leagueInfo = leagueMaster.find(
  (l) => String(l.league_key ?? "").trim() === league_key,
);

const clubLabel = clubInfo?.club_display_ja ?? club_key;
const leagueLabel = leagueInfo?.league_display_ja ?? league_key;

// 念のため、このページ自身でも正本を再確認
const ctMetaAll = loadCtSeasonMeta();

const ctMeta = findCtSeasonMeta(ctMetaAll, {
  season,
  league_key,
  club_key,
});

// --------------------
// CLモードで表示できるシーズン一覧
// ct_season_meta = CL
// ＋ ucl_league_phase に club + season が存在
// --------------------
const uclSeasonCandidates = ctMetaAll
  .filter((r) => {
    const targetSeason = String(r.season ?? "").trim();

    return (
      String(r.league_key ?? "").trim() === league_key &&
      String(r.club_key ?? "").trim() === club_key &&
      hasClubUclMode({
        season: targetSeason,
        leagueKey: league_key,
        clubKey: club_key,
      })
    );
  })
  .map((r) => String(r.season ?? "").trim())
  .filter(Boolean);

// 念のため重複除去＋新しい順
const uclSeasons = [...new Set(uclSeasonCandidates)].sort((a, b) =>
  b.localeCompare(a),
);

const uclClubUrl = (targetSeason: string) =>
  `/ucl/${encodeURIComponent(targetSeason)}` +
  `/club/${encodeURIComponent(club_key)}/`;

const uclResult = String(ctMeta?.uefa_cup_rank ?? "").trim();

// --------------------
// CLリーグフェーズ情報
// rank / pot は ucl_league_phase.csv から取得
// --------------------
const uclLeaguePhaseRows = loadUclLeaguePhaseAll();

const uclLeaguePhaseRow = uclLeaguePhaseRows.find(
  (r) =>
    String(r.season ?? "").trim() === season &&
    String(r.club_key ?? "").trim() === club_key,
);

const leaguePhaseRank = String(uclLeaguePhaseRow?.rank ?? "").trim();
const pot = String(uclLeaguePhaseRow?.pot ?? "").trim();

const hasValidUclMode = hasClubUclMode({
  season,
  leagueKey: league_key,
  clubKey: club_key,
});

// --------------------
// CLモード用 roster
// 当該seasonの最新snapshotを1枚だけ使用
// window（summer / winter）は画面には持ち込まない
// --------------------
const allClubSquadRows = loadClubSquads();

const clubSeasonRows = allClubSquadRows.filter(
  (r) =>
    String(r.league_key ?? "").trim() === league_key &&
    String(r.club_key ?? "").trim() === club_key &&
    String(r.season ?? "").trim() === season,
);

let latestSnapshot = "";

for (const r of clubSeasonRows) {
  const snap = toYMD(String(r.snapshot_date ?? ""));

  if (snap && snap > latestSnapshot) {
    latestSnapshot = snap;
  }
}

const latestRosterRows = clubSeasonRows.filter(
  (r) => toYMD(String(r.snapshot_date ?? "")) === latestSnapshot,
);

const roster = applyClubStatsMode(sortClubRoster(latestRosterRows), "uefa");

// --------------------
// 代表情報
// 国内クラブページと同じロジックを使用
// --------------------
const callups = loadCallups();

const { repLabel, repLinks } = buildRepLabelFromCallups(callups, {
  competition: "WC",
  edition: 2026,
});

const repHistoryLinks = buildRepHistoryLinksFromCallups(callups, {
  competition: "WC",
  excludeEdition: 2026,
  max: 6,
});

const columns = buildClubColumns({
  isLatestView: true,
  repLabel,
  repLinks,
  repHistoryLinks,

  // CLページでは出場成績が主役なので常時表示
  showStats: true,
});

// ====================
// CL 試合結果一覧
// 参照：src/data/competition_schedule_and_results.csv
// ====================

type UclMatchResultRow = {
  match_id: string;
  slug: string;
  competition: string;
  edition: string;
  md: string;
  stage: string;
  group: string;
  sec: string;
  datetime_local: string;
  home: string;
  home_key: string;
  away: string;
  away_key: string;
  home_score: string;
  away_score: string;
  home_score_pk: string;
  away_score_pk: string;
  note: string;
};

const readCsv = (fileName: string) => {
  const p = path.join(process.cwd(), "src", "data", fileName);
  const text = fs.readFileSync(p, "utf-8");
  return parseCsv(text);
};

const isScoreValue = (v: any) => {
  const s = String(v ?? "").trim();

  return (
    s !== "" &&
    s.toLowerCase() !== "nan" &&
    Number.isFinite(Number(s))
  );
};

const uclStageLabel = (stage: string, sec = "") => {
  const st = String(stage ?? "").trim();
  const s = String(sec ?? "").trim();

  if (st === "League Phase") return "LP";

  if (st === "KPプレーオフ") {
    return /2nd/i.test(s) ? "PO 2nd" : "PO 1st";
  }

  if (st === "Round 16") {
    return /2nd/i.test(s) ? "R16 2nd" : "R16 1st";
  }

  if (st === "Quarter-Final") {
    return /2nd/i.test(s) ? "QF 2nd" : "QF 1st";
  }

  if (st === "Semi-Final") {
    return /2nd/i.test(s) ? "SF 2nd" : "SF 1st";
  }

  if (st === "Final") return "決勝";

  return st;
};

const matchScoreCore = (m: UclMatchResultRow) => {
  if (!isScoreValue(m.home_score) || !isScoreValue(m.away_score)) {
    return "試合前";
  }

  return `${Number(m.home_score)}-${Number(m.away_score)}`;
};

const matchPkText = (m: UclMatchResultRow) => {
  if (
    isScoreValue(m.home_score_pk) &&
    isScoreValue(m.away_score_pk)
  ) {
    return `PK ${Number(m.home_score_pk)}-${Number(m.away_score_pk)}`;
  }

  return "";
};

const matchResultClass = (m: UclMatchResultRow) => {
  if (!isScoreValue(m.home_score) || !isScoreValue(m.away_score)) {
    return "is-upcoming";
  }

  const isHome = m.home_key === club_key;

  const gf = isHome
    ? Number(m.home_score)
    : Number(m.away_score);

  const ga = isHome
    ? Number(m.away_score)
    : Number(m.home_score);

  // PKがある場合はPKで勝敗判定
  if (
    isScoreValue(m.home_score_pk) &&
    isScoreValue(m.away_score_pk)
  ) {
    const pkFor = isHome
      ? Number(m.home_score_pk)
      : Number(m.away_score_pk);

    const pkAgainst = isHome
      ? Number(m.away_score_pk)
      : Number(m.home_score_pk);

    if (pkFor > pkAgainst) return "is-win";
    if (pkFor < pkAgainst) return "is-loss";
    return "is-draw";
  }

  if (gf > ga) return "is-win";
  if (gf < ga) return "is-loss";

  return "is-draw";
};

const matchResultLabel = (m: UclMatchResultRow) => {
  const cls = matchResultClass(m);

  if (cls === "is-win") return "○";
  if (cls === "is-loss") return "●";
  if (cls === "is-draw") return "△";

  return "—";
};

const opponentClubHref = (targetClubKey: string) => {
  const key = String(targetClubKey ?? "").trim();
  if (!key || key === club_key) return "";

  const opponent = clubMaster.find(
    (c: any) => String(c.club_key ?? "").trim() === key,
  );

  if (!opponent) return "";

  const opponentLeagueKey = String(
    opponent.league_key ?? "",
  ).trim();

  if (!opponentLeagueKey) return "";

  return (
    `/ucl/${encodeURIComponent(season)}` +
    `/club/${encodeURIComponent(key)}/`
  );
};

const uclMatchResultsAll: UclMatchResultRow[] = readCsv(
  "competition_schedule_and_results.csv",
).map((r: any) => ({
  match_id: String(r["match-id"] ?? "").trim(),
  slug: String(r.slug ?? "").trim(),
  competition: String(r.competition ?? "").trim(),
  edition: String(r.edition ?? "").trim(),
  md: String(r.md ?? "").trim(),
  stage: String(r.stage ?? "").trim(),
  group: String(r.group ?? "").trim(),
  sec: String(r.sec ?? "").trim(),
  datetime_local: String(r["datetime-local"] ?? "").trim(),
  home: String(r.home ?? "").trim(),
  home_key: String(r.home_key ?? "").trim(),
  away: String(r.away ?? "").trim(),
  away_key: String(r.away_key ?? "").trim(),
  home_score: String(r.home_score ?? "").trim(),
  away_score: String(r.away_score ?? "").trim(),
  home_score_pk: String(r.home_score_pk ?? "").trim(),
  away_score_pk: String(r.away_score_pk ?? "").trim(),
  note: String(r.note ?? "").trim(),
}));

const teamMatchResults = uclMatchResultsAll
  .filter(
    (m) => String(m.competition ?? "").toUpperCase() === "UCL",
  )
  .filter(
    (m) => String(m.edition ?? "").trim() === season,
  )
  .filter(
    (m) =>
      m.home_key === club_key ||
      m.away_key === club_key,
  )
  .sort((a, b) =>
  String(a.datetime_local).localeCompare(String(b.datetime_local)),
);

const hasTeamMatchResults = teamMatchResults.length > 0;

const searchTextFn = (r: any) =>
  `${r.name_ja ?? ""} ${r.name_en ?? ""} ${repLabel(r) ?? ""} ${r.nationality ?? ""}`.trim();

const clubRosterRowClass = (r: any) => {
  const note = String(r.notes ?? "")
    .trim()
    .toLowerCase();

  if (note.includes("new")) return "row-new";
  if (note.includes("out")) return "row-out";

  return "";
};

// 国内ページへ戻るURL
const domesticUrl =
  `/clubs/${encodeURIComponent(league_key)}` +
  `/club/${encodeURIComponent(club_key)}` +
  `/${encodeURIComponent(season)}/`;

const clubTopUrl =
  `/clubs/${encodeURIComponent(league_key)}` +
  `/club/${encodeURIComponent(club_key)}/`;

const uclSeasonTopUrl =
  `/ucl/${encodeURIComponent(season)}/`;

const domesticLeagueLinks = leagueMaster
  .filter((l: any) => (l.is_public ?? true) === true)
  .filter((l: any) => String(l.league_key ?? "").trim())
  .map((l: any) => ({
    key: String(l.league_key ?? "").trim(),
    label:
      String(l.league_display_ja ?? "").trim() ||
      String(l.league_key ?? "").trim(),
  }));

// SEO：ひとまずCL専用ページとして独立
const title =
  `${clubLabel} CL ${season}メンバー・出場成績・試合結果` +
  `｜UEFAチャンピオンズリーグ`;

const description =
  `${clubLabel}の${season}シーズンUEFAチャンピオンズリーグ` +
  `メンバー・出場成績・試合結果を掲載。選手ごとの出場試合数・先発数・ゴール・アシストを確認できます。`;

const heading = `${clubLabel} CL ${season} メンバー・出場成績`;
---

<BaseLayout
  title={title}
  description={description}
  bodyClass="page-ucl"
  bodyStyle="margin:0; font-family: system-ui;"
  showPageHeader={true}
  crumbs={[
    { label: "トップ", href: "/" },
    { label: "CL", href: "/ucl/" },
    { label: season, href: `/ucl/${encodeURIComponent(season)}/` },
    { label: clubLabel },
  ]}
  heading={heading}
>
  <h1 class="ucl-club-title">
    {heading}
  </h1>

  {
    hasValidUclMode && (
      <>
        <p class="ucl-club-lead">
  {clubLabel}の{season}シーズン UEFAチャンピオンズリーグ
  メンバー・出場成績・試合結果を掲載しています。
  選手ごとの出場・先発・ゴール・アシストと、大会を通じた試合結果を確認できます。
</p>

        <div class="club-mode-switch">
          <span class="club-mode-current">-- CLモード表示中 --</span>

          <a
            class="club-mode-switch-link club-mode-switch-link-domestic"
            href={domesticUrl}
          >
            国内モードへ切替
          </a>
        </div>

        {(uclResult || leaguePhaseRank || pot) && (
  <div class="ucl-club-meta">
    {uclResult && <>🏆 CL：{uclResult}</>}

    {uclResult && leaguePhaseRank && " ｜ "}

    {leaguePhaseRank && (
      <>リーグフェーズ {leaguePhaseRank}位</>
    )}

    {(uclResult || leaguePhaseRank) && pot && " ｜ "}

    {pot && <>ポット{pot}</>}
  </div>
)}

        {uclSeasons.length > 1 && (
          <div class="ucl-season-block">
            <div class="ucl-season-label">
              🔎 {clubLabel}のCL出場シーズンを見る
            </div>

            <div class="ucl-season-pills">
              {uclSeasons.map((s) => (
                <a
                  class={`ucl-season-pill ${s === season ? "is-active" : ""}`}
                  href={uclClubUrl(s)}
                >
                  {seasonShort(s)}
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="ucl-guide">
  <p class="ucl-guide-link">
    <a href={clubTopUrl}>
      🔎 {clubLabel} ポータルページを見る
    </a>
  </p>

  <p class="ucl-guide-link">
    <a href={uclSeasonTopUrl}>
      🔎 CL {seasonShort(season)}トップへ
    </a>
  </p>

  {domesticLeagueLinks.length > 0 && (
    <div class="ucl-domestic-leagues">
      <div class="ucl-guide-label">
        🔎 各国の国内リーグを見る
      </div>

      <div class="ucl-league-pills">
        {domesticLeagueLinks.map((item) => (
          <a
            class="ucl-league-pill"
            href={`/clubs/${encodeURIComponent(item.key)}/`}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  )}
</div>

{hasTeamMatchResults && (
  <section class="match-results-block" aria-label="CL試合結果一覧">
    <h2 class="match-results-title">
      📅 今大会の試合結果
    </h2>

    <div class="match-results-table-wrap">
      <table class="match-results-table">
        <thead>
          <tr>
            <th>日時</th>
            <th>Stage</th>
            <th>試合</th>
            <th>スコア</th>
            <th>結果</th>
          </tr>
        </thead>

        <tbody>
          {teamMatchResults.map((m) => {
            const resultClass = matchResultClass(m);
            const stage = uclStageLabel(m.stage, m.sec);
            const pk = matchPkText(m);

            const homeHref = opponentClubHref(m.home_key);
            const awayHref = opponentClubHref(m.away_key);

            return (
              <tr class={`match-result-row ${resultClass}`}>
                <td class="match-result-date">
                  {m.datetime_local}
                </td>

                <td class="match-result-stage">
                  {stage}
                </td>

                <td class="match-result-game">
                  <div class="match-result-game-line">
                    <span class="match-team match-team-home">
                      {homeHref ? (
                        <a href={homeHref}>{m.home}</a>
                      ) : (
                        <span>{m.home}</span>
                      )}
                    </span>

                    <span class="match-vs" aria-hidden="true">
                      vs
                    </span>

                    <span class="match-team match-team-away">
                      {awayHref ? (
                        <a href={awayHref}>{m.away}</a>
                      ) : (
                        <span>{m.away}</span>
                      )}
                    </span>
                  </div>
                </td>

                <td class="match-result-score">
                  <span>{matchScoreCore(m)}</span>

                  {pk && (
                    <div class="match-result-pk">
                      {pk}
                    </div>
                  )}
                </td>

                <td class="match-result-status">
                  <span
                    class={`match-result-badge ${resultClass}`}
                  >
                    {matchResultLabel(m)}
                  </span>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>
)}

        {roster.length > 0 ? (
          <RosterView
            tableId={`ucl-club-roster-${season}-${club_key}`}
            rows={roster}
            minWidthPx={920}
            borderColor="var(--border, #e6e6e6)"
            placeholder="検索：選手名 / 国名 / 国籍"
            searchText={searchTextFn}
            columns={columns}
            rowClass={clubRosterRowClass}
          />
        ) : (
          <p>選手データがありません。</p>
        )}
      </>
    )
  }
</BaseLayout>

<style>
  .ucl-club-lead {
    margin: 0 0 8px;
    color: #666;
    line-height: 1.7;
  }

  .club-mode-switch {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    margin: 8px 0 18px;
    flex-wrap: wrap;
  }

  .club-mode-current {
    font-size: 14px;
    font-weight: 800;
    line-height: 1;
    color: var(--theme-color);
    white-space: nowrap;
  }

  .club-mode-switch-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 8px 15px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 900;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 2px 7px rgba(0, 0, 0, 0.16);
  }

  .club-mode-switch-link-domestic {
    color: #fff;
    background: var(--color-club-accent);
    border: 2px solid var(--color-club-accent);
  }

  :global(.mob-stat-line) {
    display: none;
  }



  .ucl-season-pill {
    padding: 6px 10px;
    font-size: 12px;
  }
  }

  .ucl-club-title {
    margin: 4px 0 8px;
    font-size: 28px;
    line-height: 1.35;
    font-weight: 700;
    color: #111;
  }

  .ucl-club-meta {
    margin: 4px 0 18px;
    font-size: 16px;
    line-height: 1.6;
    font-weight: 700;
  }

  .ucl-season-block {
  margin: 8px 0 14px;
}

.ucl-season-label {
  margin: 0 0 6px;
  font-size: 14px;
  line-height: 1.4;
  font-weight: 800;
  color: var(--theme-color);
}

.ucl-season-pills {
  display: flex;
  flex-wrap: nowrap;
  gap: 8px;
  overflow-x: auto;
  overflow-y: hidden;
  max-width: 100%;
  padding-bottom: 4px;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin;
}

.ucl-season-pill {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px 12px;
  border: 1px solid #b8bec8;
  border-radius: 999px;
  background: #fff;
  color: #222;
  font-size: 14px;
  line-height: 1;
  text-decoration: underline;
  text-underline-offset: 2px;
  white-space: nowrap;
}

.ucl-season-pill.is-active {
  background: var(--theme-color);
  border-color: var(--theme-color);
  color: #fff;
  font-weight: 800;
  text-decoration: none;
}

.ucl-season-pill:hover {
  border-color: var(--theme-color);
}

.ucl-guide {
  margin: 10px 0 18px;
}

.ucl-guide-link {
  margin: 5px 0;
  font-weight: 700;
}

.ucl-guide-link a {
  color: var(--theme-color);
  text-decoration: underline;
  text-underline-offset: 3px;
}

.ucl-domestic-leagues {
  margin-top: 12px;
}

.ucl-guide-label {
  margin-bottom: 6px;
  font-size: 14px;
  font-weight: 800;
  color: var(--theme-color);
}

.ucl-league-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.ucl-league-pill {
  display: inline-flex;
  align-items: center;
  padding: 6px 11px;
  border: 1px solid
    color-mix(in srgb, var(--color-club-accent) 45%, #d1d5db);
  border-radius: 999px;
  background: #fff;
  color: var(--color-club-accent);
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
}

.ucl-league-pill:hover {
  border-color: var(--color-club-accent);
  background: color-mix(
    in srgb,
    var(--color-club-accent) 7%,
    #fff
  );
}

.ucl-league-pill:hover {
  border-color: var(--theme-color);
  color: var(--theme-color);
}

 @media (max-width: 640px) {
    .club-mode-switch {
      gap: 7px;
    }

    .club-mode-current {
      font-size: 12px;
    }

    .club-mode-switch-link {
      min-height: 34px;
      padding: 7px 11px;
      font-size: 13px;
    }

    :global(.mob-stat-line) {
      display: block;
      margin-top: 2px;
      font-size: 11px;
      line-height: 1.35;
      font-weight: 700;
