---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getUclSeasons, loadUclLeaguePhaseBySeason } from "../../lib/ucl";
import { loadClubMaster } from "../../lib/clubMaster";
import { hasClubUclMode } from "../../lib/clubCompetitionMode";

import {
  loadCompetitionSchedule,
  filterMatches,
  mdNum,
} from "../../lib/competitionSchedule";
import { getCompetitionSummary } from "../../lib/competitionSummary";
import { getCompetitionPlayerStats } from "../../lib/competitionPlayerStats";
import MatchScheduleTable from "../../components/MatchScheduleTable.astro";

import { loadLeagueMaster } from "../../lib/leagueMaster";
import { loadLeagueStandings } from "../../lib/leagueStandings";

import { loadClubSquads } from "../../lib/clubSquads";

// ✅ 静的生成
export function getStaticPaths() {
  const seasons = getUclSeasons().map((s) => String(s).trim());
  return seasons.map((season) => ({ params: { season } }));
}

const season = String(Astro.params.season ?? "").trim();

const rows = loadUclLeaguePhaseBySeason(season);

const clubMaster = loadClubMaster();
const clubMap = new Map(clubMaster.map((c: any) => [c.club_key, c]));

const leagueMaster = loadLeagueMaster();

const clubSquadRows = loadClubSquads();

const hasDomesticClubPage = (
  leagueKey: string,
  clubKey: string,
  season: string,
) =>
  clubSquadRows.some(
    (r: any) =>
      String(r.league_key ?? "").trim() === leagueKey &&
      String(r.club_key ?? "").trim() === clubKey &&
      String(r.season ?? "").trim() === season,
  );

const leagueLabelMap = new Map(
  leagueMaster
    .filter((r) => r.league_key)
    .map((r) => [
      String(r.league_key).trim(),
      String(r.league_display_ja || r.league_display_en || r.league_key).trim(),
    ]),
);

const leagueLabel = (leagueKey: string) => {
  const key = String(leagueKey ?? "").trim();
  return leagueLabelMap.get(key) || key || "—";
};

const previousSeason = (season: string) => {
  const m = String(season ?? "")
    .trim()
    .match(/^(\d{4})-(\d{2})$/);

  if (!m) return "";

  const startYear = Number(m[1]);

  return `${startYear - 1}-${String(startYear).slice(-2)}`;
};

const previousLeagueSeason = previousSeason(season);

const leagueStandings = loadLeagueStandings();

const standingByClub = new Map(
  leagueStandings
    .filter((r) => r.season === previousLeagueSeason)
    .map((r) => [`${r.league_key}|||${r.club_key}`, r]),
);

const getUclClubLeagueInfo = (r: any) => {
  const clubKey = String(r.club_key ?? "").trim();
  const c: any = clubMap.get(clubKey);

  const leagueKey = String(c?.league_key ?? "").trim();

  const overrideName = String(r.league_name_override ?? "").trim();

  const overrideRank =
    r.league_rank_override != null &&
    Number.isFinite(Number(r.league_rank_override))
      ? Number(r.league_rank_override)
      : null;

  const leagueName = overrideName || leagueLabel(leagueKey);

  const standing = leagueKey
    ? standingByClub.get(`${leagueKey}|||${clubKey}`)
    : undefined;

  const rank = overrideRank ?? (standing?.rank ? Number(standing.rank) : null);

  return {
    leagueKey,
    leagueName,
    rank,
    label: leagueName && rank ? `${leagueName} ${rank}位` : leagueName || "—",
  };
};

const summary = getCompetitionSummary("UCL", season);

const allMatches = loadCompetitionSchedule();

const uclMatches = filterMatches(allMatches, "UCL", season).sort(
  (a: any, b: any) => mdNum(a.md) - mdNum(b.md),
);

const leaguePhaseMatches = uclMatches.filter(
  (r: any) => String(r.stage ?? "").trim() === "League Phase",
);

const opponentMap = new Map<string, Set<string>>();

for (const m of leaguePhaseMatches) {
  const homeKey = String(m.homeKey ?? "").trim();
  const awayKey = String(m.awayKey ?? "").trim();

  if (!homeKey || !awayKey) continue;

  if (!opponentMap.has(homeKey)) {
    opponentMap.set(homeKey, new Set());
  }

  if (!opponentMap.has(awayKey)) {
    opponentMap.set(awayKey, new Set());
  }

  opponentMap.get(homeKey)!.add(awayKey);
  opponentMap.get(awayKey)!.add(homeKey);
}

const knockoutMatches = uclMatches.filter(
  (r: any) => String(r.stage ?? "").trim() !== "League Phase",
);

const goalRank = getCompetitionPlayerStats("UCL", season, "goals");
const assistRank = getCompetitionPlayerStats("UCL", season, "assists");
const topScorer = goalRank[0] ?? null;
const topAssist = assistRank[0] ?? null;

const majorLeagueOrder = [
  "プレミアリーグ",
  "ラ・リーガ",
  "セリエA",
  "ブンデスリーガ",
  "リーグ・アン",
  "エールディヴィジ",
  "プリメイラ・リーガ",
];

const allLeagueNames = Array.from(
  new Set(
    rows.map((r: any) => getUclClubLeagueInfo(r).leagueName).filter(Boolean),
  ),
);

const majorLeagueNames = majorLeagueOrder.filter((name) =>
  allLeagueNames.includes(name),
);

const hasOtherLeagues = allLeagueNames.some(
  (name) => !majorLeagueOrder.includes(name),
);

const leagueNames = [
  ...majorLeagueNames,
  ...(hasOtherLeagues ? ["その他"] : []),
];

const clubHrefByKey = (clubKey: string) => {
  const key = String(clubKey ?? "").trim();
  const c: any = clubMap.get(key);

  if (!c) return "";

  const leagueKey = String(c.league_key ?? "").trim();
  if (!leagueKey) return "";

  if (
    hasClubUclMode({
      season,
      leagueKey,
      clubKey: key,
    })
  ) {
    return (
      `/ucl/${encodeURIComponent(season)}` + `/club/${encodeURIComponent(key)}/`
    );
  }

  // CLモード未完成なら、国内ページが実在する場合のみそちらへ
  if (hasDomesticClubPage(leagueKey, key, season)) {
    return (
      `/clubs/${encodeURIComponent(leagueKey)}` +
      `/club/${encodeURIComponent(key)}` +
      `/${encodeURIComponent(season)}/`
    );
  }

  // CL版も国内版も未整備ならリンクしない
  return "";
};

const clubDisplay = (clubKey: string, fallback = "") => {
  const c: any = clubMap.get(String(clubKey));
  return (
    c?.club_display_ja ||
    c?.name_ja ||
    c?.club_name_en ||
    fallback ||
    clubKey ||
    "—"
  );
};

const fmt = (v: any) => ((v ?? v === 0) ? String(v) : "—");

const updated = rows[0]?.updated_at
  ? String(rows[0].updated_at).replaceAll("-", "/")
  : "—";

const title = `UEFAチャンピオンズリーグ ${season}｜出場クラブ・順位表・日程結果・得点ランキング｜海外サッカーDB`;

// under-title に “シーズンピル” を出す
const seasons = getUclSeasons()
  .map((s) => String(s).trim())
  .sort()
  .reverse();

const championHref = summary?.champion_club_key
  ? clubHrefByKey(summary.champion_club_key)
  : "";

const runnerUpHref = summary?.runner_up_club_key
  ? clubHrefByKey(summary.runner_up_club_key)
  : "";
---

<BaseLayout
  title={title}
  description={title}
  bodyClass="page-ucl"
  bodyStyle="margin:0; font-family: system-ui;"
  showPageHeader={true}
  crumbs={[
    { label: "トップ", href: "/" },
    { label: "UEFACL", href: "/ucl/" },
    { label: season },
  ]}
  heading=""
>
  <h1 class="page-title">
    UEFAチャンピオンズリーグ {season} 大会ポータル
  </h1>

  <p class="lead">
    UEFAチャンピオンズリーグ（CL）{
      season
    }シーズンの出場クラブ、リーグフェーズ順位表、決勝トーナメント日程・結果、得点・アシストランキングをまとめた大会ポータルページです。
  </p>

  <div class="pill-block">
    <div class="pill-label">🔎 シーズンを切り替える</div>

    <div class="pills">
      {
        seasons.map((s) => (
          <a
            class={`pill ${s === season ? "is-active" : ""}`}
            href={`/ucl/${encodeURIComponent(s)}/`}
          >
            <span class="dot" aria-hidden="true" />
            {s}
          </a>
        ))
      }

      <a class="pill" href="/ucl/">
        <span class="dot" aria-hidden="true"></span>シーズン一覧
      </a>
    </div>
  </div>

  <section id="summary" class="summaryBox">
    <h2>🏆 大会サマリー</h2>

    <div class="summaryGrid">
      <div>
        <span>形式</span>
        <b
          >{
            summary?.format_type === "league_phase"
              ? "リーグフェーズ(LP) ⇒ ノックアウトフェーズ(KP)"
              : summary?.format_type || "—"
          }</b
        >
      </div>

      <div>
        <span>優勝</span>
        <b>
          {
            summary?.champion_club_key ? (
              championHref ? (
                <a href={championHref}>
                  {clubDisplay(summary.champion_club_key)}
                </a>
              ) : (
                clubDisplay(summary.champion_club_key)
              )
            ) : (
              "未定"
            )
          }
        </b>
      </div>

      <div>
        <span>準優勝</span>
        <b>
          {
            summary?.runner_up_club_key ? (
              runnerUpHref ? (
                <a href={runnerUpHref}>
                  {clubDisplay(summary.runner_up_club_key)}
                </a>
              ) : (
                clubDisplay(summary.runner_up_club_key)
              )
            ) : (
              "未定"
            )
          }
        </b>
      </div>

      <div>
        <span>得点王</span>
        <b>
          {
            topScorer
              ? `${topScorer.player_name} (${topScorer.team_name_ja})`
              : "—"
          }
        </b>
      </div>

      <div>
        <span>アシスト王</span>
        <b>
          {
            topAssist
              ? `${topAssist.player_name} (${topAssist.team_name_ja})`
              : "—"
          }
        </b>
      </div>
    </div>
  </section>

  <section id="clubs">
    <h2>⚽ リーグフェーズ(LP) 出場クラブ一覧</h2>
    <div class="filter-line">
      <div class="filter-label">🔎 ポットで絞り込み</div>

      <div class="pills" id="ucl-pot-pills">
        <button class="pill clear is-active" type="button" data-pot="">
          <span class="dot"></span>全て
        </button>

        {
          [1, 2, 3, 4].map((pot) => (
            <button
              class={`pill pot-filter pot-${pot}`}
              type="button"
              data-pot={String(pot)}
            >
              <span class="dot" />
              ポット{pot}
            </button>
          ))
        }
      </div>
    </div>
    <div class="filter-line">
      <div class="filter-label">🔎 所属リーグで絞り込み</div>
      <div class="pills" id="ucl-league-pills">
        <button class="pill clear is-active" type="button" data-league="">
          <span class="dot"></span>全て
        </button>
        {
          leagueNames.map((name) => (
            <button class="pill" type="button" data-league={name}>
              <span class="dot" />
              {name}
            </button>
          ))
        }
      </div>
    </div>

    <div class="ucl-opponent-status" id="ucl-opponent-status" hidden>
      <span id="ucl-opponent-status-text" class="ucl-focus-action"></span>

      <button
        type="button"
        id="ucl-jump-to-schedule"
        class="ucl-focus-action ucl-focus-button"
      >
        ↓ 日程・結果へジャンプ
      </button>

      <button type="button" id="ucl-opponent-clear"> 選択をリセット </button>
    </div>

    <div class="team-grid" id="ucl-club-grid">
      {
        rows.map((r: any) => {
          const clubKey = String(r.club_key ?? "").trim();
          const c: any = clubMap.get(clubKey);
          const leagueInfo = getUclClubLeagueInfo(r);
          const league = leagueInfo.leagueName;
          const leagueFilter = majorLeagueOrder.includes(league)
            ? league
            : "その他";
          const pot =
            r.pot != null && Number.isFinite(Number(r.pot))
              ? String(r.pot)
              : "";

          const href = clubKey ? clubHrefByKey(clubKey) : "";
          const name = r.club_name_raw || clubDisplay(clubKey);
          const opponentKeys = clubKey
            ? [...(opponentMap.get(clubKey) ?? [])]
            : [];
          return (
            <div
              class="team-card"
              data-ucl-club-card
              data-club-key={clubKey}
              data-opponents={opponentKeys.join("|")}
              data-league={leagueFilter}
              data-pot={pot}
            >
              <div class="row1">
                <div class="name">{name}</div>
              </div>

              <div class="meta">
                <span class={`badge pot-badge ${pot ? `pot-${pot}` : ""}`}>
                  {pot ? `ポット${pot}` : "ポット —"}
                </span>

                <span class="badge">{leagueInfo.label}</span>
              </div>

              <div class="team-card-actions">
                {href ? (
                  <a class="team-card-link" href={href}>
                    👕メンバー一覧へ
                  </a>
                ) : (
                  <span class="team-card-link is-disabled">メンバー一覧へ</span>
                )}

                <button
                  type="button"
                  class="team-card-opponents"
                  data-ucl-opponents-button
                  data-club-key={clubKey}
                  disabled={!clubKey}
                >
                  🔎 対戦相手を見る
                </button>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <section id="league-phase-schedule">
    <h2>🏟 リーグフェーズ(LP) 日程・結果</h2>

    <div class="ucl-lp-filter-status" id="ucl-lp-filter-status" hidden>
      <span id="ucl-lp-filter-status-text" class="ucl-focus-action"></span>

      <button
        type="button"
        id="ucl-jump-to-clubs"
        class="ucl-focus-action ucl-focus-button"
      >
        ↑ 出場クラブ一覧へ戻る
      </button>

      <button type="button" id="ucl-lp-filter-clear"> 選択をリセット </button>
    </div>

    <MatchScheduleTable
      matches={leaguePhaseMatches}
      heading={`UCL ${season} リーグフェーズ`}
      showMatchLinks={false}
    />
  </section>

  <section id="league-phase">
    <h2>📊 リーグフェーズ(LP)順位表</h2>
    <div class="ucl-meta">
      <span>クラブ数：{rows.length}</span>
      <span>更新：{updated}</span>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th style="text-align:center;">クラブ</th>
            <th>試</th><th>勝</th><th>分</th><th>敗</th>
            <th>得</th><th>失</th><th>差</th><th>点</th>
            <th>枠</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r: any) => {
              const clubKey = String(r.club_key ?? "").trim();
              const href = clubKey ? clubHrefByKey(clubKey) : "";
              return (
                <tr>
                  <td>{fmt(r.rank)}</td>
                  <td class="left">
                    {href ? (
                      <a class="club-link" href={href}>
                        {r.club_name_raw ?? r.club_key}
                      </a>
                    ) : (
                      (r.club_name_raw ?? "—")
                    )}
                  </td>
                  <td>{fmt(r.played)}</td>
                  <td>{fmt(r.won)}</td>
                  <td>{fmt(r.draw)}</td>
                  <td>{fmt(r.lost)}</td>
                  <td>{fmt(r.gf)}</td>
                  <td>{fmt(r.ga)}</td>
                  <td>{fmt(r.gd)}</td>
                  <td>{fmt(r.pts)}</td>
                  <td>
                    <span class="pill small">{fmt(r.qualified)}</span>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <p class="note">
      ※ 上位8クラブはラウンド16へ。9～24位の16クラブはKOフェーズ進出をかけてPO
    </p>
  </section>

  <section id="schedule">
    <h2>🏟 ノックアウトフェーズ(KP) 日程・結果</h2>
    <MatchScheduleTable
      matches={knockoutMatches}
      heading={`UCL ${season} 決勝トーナメント`}
      showMatchLinks={false}
    />
  </section>

  <section id="rankings">
    <h2>🥇 得点・アシストランキング</h2>

    <div class="rank-grid">
      <div class="rank-card">
        <h3>得点ランキング</h3>
        {
          goalRank.length === 0 ? (
            <p class="note">データ準備中です。</p>
          ) : (
            <table class="rank">
              <thead>
                <tr>
                  <th>順位</th>
                  <th>選手</th>
                  <th>クラブ</th>
                  <th class="num">得点</th>
                </tr>
              </thead>
              <tbody>
                {goalRank.map((r: any) => (
                  <tr>
                    <td>{r.rank}</td>
                    <td>{r.player_name}</td>
                    <td>
                      {(() => {
                        const teamKey = String(r.team_key ?? "").trim();
                        const href = teamKey ? clubHrefByKey(teamKey) : "";
                        const label = r.team_name_ja || clubDisplay(teamKey);

                        return href ? (
                          <a class="club-link" href={href}>
                            {label}
                          </a>
                        ) : (
                          <span>{label}</span>
                        );
                      })()}
                    </td>
                    <td class="num">
                      <b>{r.goals || "—"}</b>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )
        }
      </div>

      <div class="rank-card">
        <h3>アシストランキング</h3>
        {
          assistRank.length === 0 ? (
            <p class="note">データ準備中です。</p>
          ) : (
            <table class="rank">
              <thead>
                <tr>
                  <th>順位</th>
                  <th>選手</th>
                  <th>クラブ</th>
                  <th class="num">アシスト</th>
                </tr>
              </thead>
              <tbody>
                {assistRank.map((r: any) => (
                  <tr>
                    <td>{r.rank}</td>
                    <td>{r.player_name}</td>
                    <td>
                      {(() => {
                        const teamKey = String(r.team_key ?? "").trim();
                        const href = teamKey ? clubHrefByKey(teamKey) : "";
                        const label = r.team_name_ja || clubDisplay(teamKey);

                        return href ? (
                          <a class="club-link" href={href}>
                            {label}
                          </a>
                        ) : (
                          <span>{label}</span>
                        );
                      })()}
                    </td>
                    <td class="num">
                      <b>{r.assists || "—"}</b>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )
        }
      </div>
    </div>
  </section>

  <style is:global>
    /* ===== UCL theme（ニュートラル寄り） ===== */
    .page-ucl .ucl-top {
      margin: 6px 0 12px;
    }
    .page-ucl .ucl-meta {
      color: #666;
      font-size: 12.5px;
      margin: 0 0 10px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .page-ucl .table-wrap {
      /* ✅ この箱の中で縦スクロールさせる（stickyを安定させる） */
      overflow: auto; /* 横も縦もここでスクロール */
      max-height: calc(
        100vh - 260px
      ); /* だいたい: TitleBar + crumbs + pills分 */
      background: #fff;
      border: 1px solid #e6e6e6;
      border-radius: 12px;
      -webkit-overflow-scrolling: touch;
    }

    .page-ucl table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      min-width: 760px;
    }

    .page-ucl thead th {
      position: sticky;
      top: 0; /* ✅ “箱”の先頭に張り付くのでオフセット不要 */
      z-index: 3; /* ✅ 行より前に出す */
      background: #f7f7f7; /* ✅ 透け防止 */
      border-bottom: 1px solid #e6e6e6;
      padding: 10px 10px;
      font-size: 12.5px;
      text-align: center;
      white-space: nowrap;
    }

    /* ✅ TitleBar の高さ分だけ sticky を下げる（BaseLayout の padding-top と同値） */
    .has-titlebar-2.page-ucl thead th {
      top: 56px;
    }
    .has-titlebar-1.page-ucl thead th {
      top: 40px;
    }

    .page-ucl tbody td {
      border-bottom: 1px solid #f0f0f0;
      padding: 9px 10px;
      font-size: 13px;
      text-align: center;
      white-space: nowrap;
    }

    .page-ucl tbody tr:hover {
      background: #fafafa;
    }
    .page-ucl td.left {
      text-align: left;
    }

    .page-ucl a {
      color: #111;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .page-ucl a:hover {
      background: #eef6fd;
    }

    /* pills（既存の見た目に寄せつつ UCL らしく青寄せ） */
    .page-ucl .pills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .page-ucl .pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 10px;
      border-radius: 999px;
      border: 1px solid #cfe0ff;
      background: #fff;
      color: #111;
      text-decoration: none;
      font-size: 13px;
      line-height: 1;
    }
    .page-ucl .pill:hover {
      background: #eef6fd;
    }
    .page-ucl .pill .dot {
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: #2563eb;
      opacity: 0.6;
    }
    .page-ucl .pill.is-active {
      font-weight: 800;
      border-color: #2563eb;
    }
    .page-ucl .pill.is-active .dot {
      opacity: 1;
    }

    .page-ucl .pill.small {
      padding: 2px 8px;
      font-size: 12px;
      border-color: #e6e6e6;
    }

    /* ✅ UCL表：箱内で上に詰める（謎の空白対策） */
    .page-ucl .table-wrap {
      padding: 0; /* ← まずpaddingをゼロに固定 */
    }

    .page-ucl .table-wrap table {
      margin: 0; /* ← tableのデフォmargin除去 */
      border-collapse: separate;
      border-spacing: 0; /* ← 余計な隙間を消す */
    }

    /* ✅ theadの高さがズレる環境対策（特にSafari/Chromium差分） */
    .page-ucl .table-wrap thead {
      transform: translateZ(0);
    }

    /* ✅ stickyヘッダーが最上部にピタッと来るように */
    .page-ucl .table-wrap thead th {
      top: 0; /* 念押し（他CSSの上書き防止） */
    }

    /* CL順位表ヘッダー */
    .page-ucl table thead th {
      background: color-mix(in srgb, var(--color-ucl) 28%, white);
    }

    .page-ucl .page-title {
      margin: 6px 0 10px;
      font-size: 28px;
      line-height: 1.35;
      color: #111;
    }

    .page-ucl .lead {
      margin: 4px 0 14px;
      font-size: 13px;
      color: #666;
      line-height: 1.6;
    }

    .page-ucl .pill-block {
      margin: 10px 0 14px;
    }

    .page-ucl .pill-label {
      font-size: 15px;
      color: #666;
      margin-bottom: 6px;
      font-weight: 600;
    }

    .page-ucl .note {
      margin: 10px 0 0;
      font-size: 12.5px;
      color: #666;
    }

    .page-ucl .summaryBox {
      margin: 18px 0;
      padding: 14px;
      border: 1px solid
        color-mix(in srgb, var(--color-ucl, #0f3b82) 45%, #dbeafe);
      border-left: 6px solid var(--color-ucl, #0f3b82);
      border-radius: 14px;
      background: color-mix(in srgb, var(--color-ucl, #0f3b82) 7%, white);
    }

    .page-ucl .summaryGrid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 10px;
    }

    .page-ucl .summaryGrid div {
      padding: 10px;
      border-radius: 12px;
      background: #fff;
      border: 1px solid #e6e6e6;
    }

    .page-ucl .summaryGrid span {
      display: block;
      font-size: 12px;
      color: #666;
      margin-bottom: 4px;
    }

    .page-ucl .summaryGrid b {
      font-size: 14px;
    }

    .page-ucl .team-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
      gap: 10px;
      margin-top: 10px;
    }

    .page-ucl .team-card {
      display: block;
      padding: 10px 12px;
      border: 1px solid #e6e6e6;
      border-radius: 14px;
      background: #fff;
      color: #111;
    }

    .page-ucl .team-card-actions {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-top: 10px;
      flex-wrap: wrap;
    }

    .page-ucl .team-card-link,
    .page-ucl .team-card-opponents {
      padding: 0;
      min-height: auto;
      border: 0;
      border-radius: 0;
      background: transparent;
      font-size: 12px;
      font-weight: 700;
    }

    .page-ucl .team-card-link {
      color: var(--theme-color);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .page-ucl .team-card-link:hover {
      color: #fff;
      background: var(--theme-color);
    }

    .page-ucl .team-card-opponents {
      color: #c0392b;
      cursor: pointer;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .page-ucl .team-card-opponents:hover {
      background: color-mix(in srgb, var(--theme-color) 7%, white);
    }

    .page-ucl .team-card-link.is-disabled {
      opacity: 0.45;
      cursor: default;
    }

    .page-ucl .team-card-opponents:disabled {
      opacity: 0.45;
      cursor: default;
    }

    .page-ucl .team-card.is-disabled {
      opacity: 0.75;
    }

    .page-ucl .team-card .name {
      font-weight: 800;
    }

    .page-ucl .team-card .meta {
      margin-top: 8px;
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    /* ===== LP対戦相手ハイライト ===== */

    .page-ucl .team-card {
      transition:
        opacity 0.15s ease,
        background 0.15s ease,
        border-color 0.15s ease,
        box-shadow 0.15s ease;
    }

    /* 選択したクラブ */
    .page-ucl .team-card.is-selected-club {
      opacity: 1;
      background: color-mix(in srgb, var(--theme-color) 13%, white);
      border-color: var(--theme-color);
      box-shadow: 0 0 0 2px
        color-mix(in srgb, var(--theme-color) 18%, transparent);
    }

    /* 対戦相手 */
    .page-ucl .team-card.is-opponent-club {
      opacity: 1;
      background: color-mix(in srgb, var(--theme-color) 5%, white);
      border-color: color-mix(in srgb, var(--theme-color) 55%, #e6e6e6);
    }

    /* 非対戦クラブ */
    .page-ucl .team-card.is-dimmed-club {
      opacity: 0.28;
    }

    /* 選択中ボタン */
    .page-ucl .team-card-opponents.is-active {
      color: #c0392b;
      font-size: 16px;
      font-weight: 1200;
      text-decoration: none;
    }

    /* 選択状態説明 */
    .page-ucl .ucl-opponent-status,
    .page-ucl .ucl-lp-filter-status {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px 12px;
      margin: 12px 0 10px;
    }

    .page-ucl #ucl-opponent-status-text,
    .page-ucl #ucl-lp-filter-status-text {
      flex-basis: 100%;
      font-size: 20px;
      font-weight: 900;
      line-height: 1.5;
      color: #c0392b;
    }

    .page-ucl .ucl-opponent-status[hidden] {
      display: none;
    }

    .page-ucl .ucl-lp-filter-status[hidden] {
      display: none;
    }

    /* ===== 対戦可視化機能の操作色 ===== */

    .page-ucl .ucl-focus-action {
      color: var(--theme-color);
      font-weight: 800;
    }

    .page-ucl .ucl-focus-button {
      padding: 0;
      border: 0;
      background: transparent;
      font-size: 14px;
      text-decoration: underline;
      text-underline-offset: 2px;
      cursor: pointer;
    }

    .page-ucl .ucl-focus-button:hover {
      color: #922b21;
      background: transparent;
    }

    .page-ucl #clubs,
    .page-ucl #league-phase-schedule {
      scroll-margin-top: 80px;
    }

    .page-ucl #ucl-opponent-clear {
      padding: 0;
      border: 0;
      background: transparent;
      color: #c0392b;
      font-size: 14px;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 2px;
      cursor: pointer;
    }

    .page-ucl .badge {
      display: inline-flex;
      padding: 2px 8px;
      border-radius: 999px;
      border: 1px solid #e6e6e6;
      font-size: 12px;
      background: #fff;
    }

    /* ===== UCL Pot colors ===== */

    /* Pot 1：CLテーマカラー */
    .page-ucl .pot-1 {
      --pot-color: var(--color-ucl, #0f3b82);
      --pot-bg: color-mix(in srgb, var(--color-ucl, #0f3b82) 12%, white);
    }

    /* Pot 2：緑 */
    .page-ucl .pot-2 {
      --pot-color: #166534;
      --pot-bg: #dcfce7;
    }

    /* Pot 3：黄 */
    .page-ucl .pot-3 {
      --pot-color: #92400e;
      --pot-bg: #fef3c7;
    }

    /* Pot 4：赤 */
    .page-ucl .pot-4 {
      --pot-color: #991b1b;
      --pot-bg: #fee2e2;
    }

    /* カード内Potバッジ */
    .page-ucl .pot-badge.pot-1,
    .page-ucl .pot-badge.pot-2,
    .page-ucl .pot-badge.pot-3,
    .page-ucl .pot-badge.pot-4 {
      color: var(--pot-color);
      background: var(--pot-bg);
      border-color: color-mix(in srgb, var(--pot-color) 30%, white);
      font-weight: 700;
    }

    /* Pot絞り込み */
    .page-ucl .pot-filter.pot-1 .dot,
    .page-ucl .pot-filter.pot-2 .dot,
    .page-ucl .pot-filter.pot-3 .dot,
    .page-ucl .pot-filter.pot-4 .dot {
      background: var(--pot-color);
      opacity: 1;
    }

    .page-ucl .pot-filter.pot-1.is-active,
    .page-ucl .pot-filter.pot-2.is-active,
    .page-ucl .pot-filter.pot-3.is-active,
    .page-ucl .pot-filter.pot-4.is-active {
      color: var(--pot-color);
      background: var(--pot-bg);
      border-color: var(--pot-color);
      font-weight: 800;
    }

    .page-ucl .rank-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 12px;
      margin-top: 10px;
    }

    .page-ucl .rank-card {
      padding: 12px;
      border: 1px solid #e6e6e6;
      border-radius: 14px;
      background: #fff;
    }

    .page-ucl table.rank {
      width: 100%;
      min-width: 0;
      border-collapse: collapse;
      font-size: 13px;
    }

    .page-ucl table.rank th,
    .page-ucl table.rank td {
      border-top: 1px solid #e6e6e6;
      padding: 8px;
      text-align: left;
    }

    .page-ucl table.rank .num {
      text-align: right;
    }

    .page-ucl .summaryGrid a {
      color: var(--theme-color);
      font-weight: 700;
    }

    .page-ucl .summaryGrid a:hover {
      color: var(--theme-color);
    }

    .page-ucl .club-link {
      color: var(--theme-color);
      font-weight: 600;
    }

    .page-ucl #ucl-lp-filter-clear {
      padding: 0;
      border: 0;
      background: transparent;
      color: #c0392b;
      font-size: 14px;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 2px;
      cursor: pointer;
    }
  </style>

  <script is:inline>
    const $$ = (sel) => Array.from(document.querySelectorAll(sel));

    window.addEventListener("DOMContentLoaded", () => {
      const leaguePills = $$("#ucl-league-pills [data-league]");
      const potPills = $$("#ucl-pot-pills [data-pot]");
      const cards = $$("[data-ucl-club-card]");
      const opponentButtons = $$("[data-ucl-opponents-button]");
      const opponentStatus = document.getElementById("ucl-opponent-status");
      const opponentStatusText = document.getElementById(
        "ucl-opponent-status-text",
      );
      const opponentClear = document.getElementById("ucl-opponent-clear");

      const leaguePhaseMatchRows = $$(
        "#league-phase-schedule [data-match-row]",
      );

      const lpFilterStatus = document.getElementById("ucl-lp-filter-status");

      const lpFilterStatusText = document.getElementById(
        "ucl-lp-filter-status-text",
      );

      const lpFilterClear = document.getElementById("ucl-lp-filter-clear");

      const jumpToSchedule = document.getElementById("ucl-jump-to-schedule");

      const jumpToClubs = document.getElementById("ucl-jump-to-clubs");

      let selectedClubKey = "";

      let currentLeague = "";
      let currentPot = "";

      function applyFilter() {
        cards.forEach((card) => {
          const league = card.getAttribute("data-league") || "";
          const pot = card.getAttribute("data-pot") || "";

          const okLeague = currentLeague === "" || league === currentLeague;

          const okPot = currentPot === "" || pot === currentPot;

          card.style.display = okLeague && okPot ? "" : "none";
        });
      }

      function resetOpponentHighlight() {
        selectedClubKey = "";

        cards.forEach((card) => {
          card.classList.remove(
            "is-selected-club",
            "is-opponent-club",
            "is-dimmed-club",
          );
        });

        opponentButtons.forEach((button) => {
          button.classList.remove("is-active");
          button.textContent = "🔎 対戦相手を見る";
          button.setAttribute("aria-pressed", "false");
        });

        if (opponentStatus) {
          opponentStatus.hidden = true;
        }

        if (opponentStatusText) {
          opponentStatusText.textContent = "";
        }

        resetLeaguePhaseMatchFilter();
      }

      function resetClubFilters() {
        currentLeague = "";
        currentPot = "";

        leaguePills.forEach((pill) => {
          pill.classList.toggle(
            "is-active",
            (pill.getAttribute("data-league") || "") === "",
          );
        });

        potPills.forEach((pill) => {
          pill.classList.toggle(
            "is-active",
            (pill.getAttribute("data-pot") || "") === "",
          );
        });

        applyFilter();
      }

      function selectClub(card, button) {
        const clubKey = card.getAttribute("data-club-key") || "";

        if (!clubKey) return;

        // 同じクラブをもう一度押したら解除
        if (selectedClubKey === clubKey) {
          resetOpponentHighlight();
          return;
        }

        selectedClubKey = clubKey;

        // 対戦関係を見る時は36クラブ全部を表示する
        resetClubFilters();

        const opponents = new Set(
          (card.getAttribute("data-opponents") || "")
            .split("|")
            .filter(Boolean),
        );

        cards.forEach((targetCard) => {
          const targetKey = targetCard.getAttribute("data-club-key") || "";

          targetCard.classList.remove(
            "is-selected-club",
            "is-opponent-club",
            "is-dimmed-club",
          );

          if (targetKey === clubKey) {
            targetCard.classList.add("is-selected-club");
          } else if (opponents.has(targetKey)) {
            targetCard.classList.add("is-opponent-club");
          } else {
            targetCard.classList.add("is-dimmed-club");
          }
        });

        opponentButtons.forEach((targetButton) => {
          const targetKey = targetButton.getAttribute("data-club-key") || "";

          const active = targetKey === clubKey;

          targetButton.classList.toggle("is-active", active);
          targetButton.setAttribute("aria-pressed", active ? "true" : "false");

          targetButton.textContent = active ? "✓ 選択中" : "🔎 対戦相手を見る";
        });

        const clubName =
          card.querySelector(".name")?.textContent?.trim() || clubKey;

        applyLeaguePhaseMatchFilter(clubKey, clubName);

        if (opponentStatus && opponentStatusText) {
          opponentStatusText.textContent = `※ ${clubName}のLP対戦カード（絞込表示中）`;

          opponentStatus.hidden = false;
        }

        lpFilterClear?.addEventListener("click", () => {
          resetOpponentHighlight();
        });
      }

      function resetLeaguePhaseMatchFilter() {
        leaguePhaseMatchRows.forEach((row) => {
          row.style.display = "";
        });

        if (lpFilterStatus) {
          lpFilterStatus.hidden = true;
        }

        if (lpFilterStatusText) {
          lpFilterStatusText.textContent = "";
        }
      }

      function applyLeaguePhaseMatchFilter(clubKey, clubName) {
        if (!clubKey) {
          resetLeaguePhaseMatchFilter();
          return;
        }

        let visibleCount = 0;

        leaguePhaseMatchRows.forEach((row) => {
          const homeKey = row.getAttribute("data-home-key") || "";

          const awayKey = row.getAttribute("data-away-key") || "";

          const visible = homeKey === clubKey || awayKey === clubKey;

          row.style.display = visible ? "" : "none";

          if (visible) {
            visibleCount++;
          }
        });

        if (lpFilterStatus && lpFilterStatusText) {
          lpFilterStatusText.textContent = `※ ${clubName}のLP対戦カード（絞込表示中）（${visibleCount}試合）`;

          lpFilterStatus.hidden = false;
        }
      }

      opponentButtons.forEach((button) => {
        button.setAttribute("aria-pressed", "false");

        button.addEventListener("click", () => {
          const clubKey = button.getAttribute("data-club-key") || "";

          const card = cards.find(
            (item) => (item.getAttribute("data-club-key") || "") === clubKey,
          );

          if (!card) return;

          selectClub(card, button);
        });
      });

      opponentClear?.addEventListener("click", () => {
        resetOpponentHighlight();
      });

      leaguePills.forEach((pill) => {
        pill.addEventListener("click", () => {
          currentLeague = pill.getAttribute("data-league") || "";

          leaguePills.forEach((p) => {
            p.classList.toggle("is-active", p === pill);
          });

          applyFilter();
        });
      });

      potPills.forEach((pill) => {
        pill.addEventListener("click", () => {
          currentPot = pill.getAttribute("data-pot") || "";

          potPills.forEach((p) => {
            p.classList.toggle("is-active", p === pill);
          });

          applyFilter();
        });
      });

      jumpToSchedule?.addEventListener("click", () => {
        document.getElementById("league-phase-schedule")?.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      });

      jumpToClubs?.addEventListener("click", () => {
        document.getElementById("clubs")?.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
      });

      /* 初期状態を明示的に全表示 */
      applyFilter();
    });
  </script>
</BaseLayout>
