  <script is:inline>
    function initIwLineupModal() {
      const openBtn = document.getElementById("iw-lineup-open");
      const closeBtn = document.getElementById("iw-lineup-close");
      const modal = document.getElementById("iw-lineup-modal");

      if (!openBtn || !closeBtn || !modal) return;

      openBtn.addEventListener("click", () => {
        if (typeof modal.showModal === "function") {
          modal.showModal();
        }
      });

      closeBtn.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();

        if (typeof modal.close === "function") {
          modal.close();
        }
      });

      modal.addEventListener("click", (event) => {
        const rect = modal.getBoundingClientRect();

        const isInDialog =
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width;

        if (!isInDialog && typeof modal.close === "function") {
          modal.close();
        }
      });
    }

    if (document.readyState === "loading") {
      window.addEventListener("DOMContentLoaded", initIwLineupModal);
    } else {
      initIwLineupModal();
    }
  </script>
