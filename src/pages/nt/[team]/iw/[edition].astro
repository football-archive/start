---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import RosterView from "../../../../components/RosterView.astro";

import { parseCsv } from "../../../../lib/csvSimple";
import { loadCallups, sortForRoster } from "../../../../lib/callups";
import { loadClubMaster } from "../../../../lib/clubMaster";
import { loadClubSquads } from "../../../../lib/clubSquads";
import { buildNtColumns } from "../../../../lib/rosterColumns";
import { clubUrl } from "../../../../lib/urls";

import fs from "node:fs";
import path from "node:path";

type CsvRow = Record<string, string>;

type CountryRow = {
  country_key: string;
  country_name_ja: string;
};

function readCsv(fileName: string): CsvRow[] {
  const filePath = path.join(process.cwd(), "src", "data", fileName);
  return parseCsv(fs.readFileSync(filePath, "utf-8")) as CsvRow[];
}

function clean(value: unknown): string {
  return String(value ?? "").trim();
}

function normalize(value: unknown): string {
  return clean(value).replace(/　/g, " ").replace(/\s+/g, " ").toLowerCase();
}

function formatSnapshotDate(value: unknown): string {
  const raw = clean(value);
  if (!raw) return "";

  const m = raw.match(/^(\d{4})[\/.-](\d{1,2})[\/.-](\d{1,2})/);
  if (!m) return raw;

  return `${m[1]}年${Number(m[2])}月${Number(m[3])}日`;
}

function formatEdition(value: unknown): string {
  const edition = clean(value);

  if (!/^\d{6}$/.test(edition)) {
    return edition;
  }

  const year = edition.slice(0, 4);
  const month = String(Number(edition.slice(4, 6)));

  return `${year}年${month}月`;
}

function editionToClubSeason(edition: string): string {
  if (!/^\d{6}$/.test(edition)) return "";

  const year = Number(edition.slice(0, 4));
  const month = Number(edition.slice(4, 6));

  if (!Number.isFinite(year) || !Number.isFinite(month)) return "";

  if (month >= 7) {
    return `${year}-${String(year + 1).slice(2)}`;
  }

  return `${year - 1}-${String(year).slice(2)}`;
}

// ====================
// Static Paths
// IWデータが存在する国×editionだけ生成
// ====================
export async function getStaticPaths() {
  const readCsvForPaths = (fileName: string): CsvRow[] => {
    const filePath = path.join(process.cwd(), "src", "data", fileName);
    return parseCsv(fs.readFileSync(filePath, "utf-8")) as CsvRow[];
  };

  const cleanForPaths = (value: unknown): string => String(value ?? "").trim();

  const normalizeForPaths = (value: unknown): string =>
    cleanForPaths(value).replace(/　/g, " ").replace(/\s+/g, " ").toLowerCase();

  const countries = readCsvForPaths("country_master.csv").map((row) => ({
    country_key: cleanForPaths(row.country_key),
    country_name_ja: cleanForPaths(row.country_name_ja),
  })) as CountryRow[];

  const countryKeyByName = new Map(
    countries.map((country) => [
      normalizeForPaths(country.country_name_ja),
      country.country_key,
    ]),
  );

  const callups = readCsvForPaths("callups_site.csv");

  const seen = new Set<string>();
  const paths = [];

  for (const row of callups) {
    if (cleanForPaths(row.competition).toUpperCase() !== "IW") {
      continue;
    }

    const edition = cleanForPaths(row.edition);
    const countryName = cleanForPaths(row.country);

    const team = countryKeyByName.get(normalizeForPaths(countryName));

    if (!edition || !team) continue;

    const key = `${team}:${edition}`;

    if (seen.has(key)) continue;

    seen.add(key);

    paths.push({
      params: {
        team,
        edition,
      },
      props: {
        countryName,
      },
    });
  }

  return paths;
}

// ====================
// Page Data
// ====================
const { team, edition } = Astro.params;

const teamSlug = clean(team);
const editionKey = clean(edition);

const countries = readCsv("country_master.csv").map((row) => ({
  country_key: clean(row.country_key),
  country_name_ja: clean(row.country_name_ja),
})) as CountryRow[];

const country = countries.find((row) => row.country_key === teamSlug);

if (!country) {
  throw new Error(
    `country_master.csv に country_key=${teamSlug} が見つかりません`,
  );
}

const countryName = country.country_name_ja;
const countryNameByKey = new Map(
  countries.map((row) => [clean(row.country_key), clean(row.country_name_ja)]),
);

const countryKeyByName = new Map(
  countries.map((row) => [
    normalize(row.country_name_ja),
    clean(row.country_key),
  ]),
);

const iwTeamSetForEdition = new Set(
  loadCallups()
    .filter(
      (row: any) =>
        clean(row.competition).toUpperCase() === "IW" &&
        clean(row.edition) === editionKey,
    )
    .map((row: any) => countryKeyByName.get(normalize(row.country)) ?? "")
    .filter(Boolean),
);

const rows = loadCallups()
  .filter(
    (row) =>
      clean(row.competition).toUpperCase() === "IW" &&
      clean(row.edition) === editionKey &&
      clean(row.country) === countryName,
  )
  .sort(sortForRoster);

if (rows.length === 0) {
  throw new Error(
    `IW ${editionKey} / ${countryName} のcallupsデータが見つかりません`,
  );
}

const starRows = rows
  .filter((row: any) => clean(row.is_star) === "1")
  .slice(0, 3);

const continent = clean((rows[0] as any)?.confederation);

const sameContinentMap = new Map<string, { key: string; name: string }>();

for (const row of loadCallups() as any[]) {
  if (clean(row.confederation) !== continent) continue;

  const name = clean(row.country);
  if (!name || name === countryName) continue;

  const key = countryKeyByName.get(normalize(name));
  if (!key) continue;

  if (!sameContinentMap.has(key)) {
    sameContinentMap.set(key, {
      key,
      name: countryNameByKey.get(key) || name,
    });
  }
}

const sameContinentTeams = Array.from(sameContinentMap.values()).sort((a, b) =>
  a.name.localeCompare(b.name, "ja"),
);

const rowHighlightClass = (row: any) => {
  const noteText = clean(
    row.notes ?? row.note ?? row.remarks ?? row.note_ja ?? "",
  );

  if (!/^\d{6}$/.test(editionKey)) {
    return "";
  }

  const year = editionKey.slice(0, 4);
  const month = editionKey.slice(4, 6);

  const editionPattern = new RegExp(`${year}[./-]?${month}`);

  return editionPattern.test(noteText) ? "row-highlight" : "";
};

const iwActivityAll = readCsv("nt_iw_activity.csv");

const iwActivityRows = iwActivityAll.filter(
  (row) =>
    clean(row.team_slug) === teamSlug && clean(row.edition) === editionKey,
);

const announcementDate = clean(iwActivityRows[0]?.announcement_date);
const coach = clean(iwActivityRows[0]?.coach_ja);

const activityMatches = iwActivityRows
  .map((row) => {
    const opponentKey = clean(row.opponent_key);

    const opponentName = countryNameByKey.get(opponentKey) || opponentKey;

    const opponentHref =
      opponentKey &&
      opponentKey !== teamSlug &&
      iwTeamSetForEdition.has(opponentKey)
        ? `/nt/${opponentKey}/iw/${editionKey}/`
        : "";

    const date = clean(row.date);
    const dateMatch = date.match(/^\d{4}-(\d{1,2})-(\d{1,2})$/);

    const dateLabel = dateMatch
      ? `${Number(dateMatch[1])}/${Number(dateMatch[2])}`
      : date;

    return {
      date,
      dateLabel,
      opponentKey,
      opponentName,
      opponentHref,
      venueType: clean(row.venue_type).toUpperCase(),
      score: clean(row.score),
      note: clean(row.note),
    };
  })
  .filter((row) => row.opponentKey)
  .sort((a, b) => a.date.localeCompare(b.date));

const latestSnapshot =
  rows
    .map((row) => clean(row.snapshot_date))
    .filter(Boolean)
    .sort()
    .at(-1) ?? "";

const editionNoteTag = /^\d{6}$/.test(editionKey)
  ? `${editionKey.slice(0, 4)}.${editionKey.slice(4, 6)}`
  : "";

const calledCount = editionNoteTag
  ? rows.filter((row: any) =>
      clean(row.notes ?? row.note ?? row.remarks ?? row.note_ja ?? "").includes(
        editionNoteTag,
      ),
    ).length
  : 0;

const fifaRankRows = readCsv("fifa_rank.csv");

const iwFifaRank = fifaRankRows
  .filter(
    (row) =>
      clean(row.competition).toUpperCase() === "IW" &&
      clean(row.year) === editionKey &&
      clean(row.country_name_ja) === countryName,
  )
  .sort((a, b) => clean(b.rank_date).localeCompare(clean(a.rank_date)))[0];

const iwFifaRankValue = clean(iwFifaRank?.fifa_rank);
const iwFifaRankDate = clean(iwFifaRank?.rank_date);

const iwFifaRankDateLabel = (() => {
  const m = iwFifaRankDate.match(/^(\d{4})-(\d{1,2})/);
  if (!m) return iwFifaRankDate;

  return `${m[1]}.${String(Number(m[2])).padStart(2, "0")}`;
})();

const lineupRows = readCsv("nt_lineup_images.csv")
  .filter(
    (row) =>
      clean(row.competition).toUpperCase() === "IW" &&
      clean(row.year) === editionKey &&
      clean(row.team_slug) === teamSlug,
  )
  .map((row) => ({
    formation: clean(row.formation),
    image: clean(row.image),
  }))
  .filter((row) => row.image);

const iwLineup = lineupRows.find((row) => {
  const imagePath = path.join(
    process.cwd(),
    "public",
    "images",
    "lineups",
    row.image,
  );

  return fs.existsSync(imagePath);
});

const iwLineupImageSrc = iwLineup ? `/images/lineups/${iwLineup.image}` : "";

const iwLineupFormation = iwLineup?.formation ?? "";

const clubMaster = loadClubMaster();

const clubSquads = loadClubSquads();

const clubSquadKeySet = new Set(
  clubSquads.map(
    (row: any) =>
      `${row.season}|||${row.window}|||${row.league_key}|||${row.club_key}`,
  ),
);

const parseAliases = (aliases: string) =>
  String(aliases || "")
    .split(/[|,、/]/)
    .map((value) => value.trim())
    .filter(Boolean);

const resolveClubMaster = (clubName: string) => {
  const key = normalize(clubName);
  if (!key) return null;

  return (
    clubMaster.find((club: any) => {
      if (normalize(club.club_display_ja) === key) return true;
      if (normalize(club.club_display_en) === key) return true;

      return parseAliases(club.aliases).some(
        (alias) => normalize(alias) === key,
      );
    }) ?? null
  );
};

const clubSeason = editionToClubSeason(editionKey);

const clubHref = (clubName: string) => {
  const club: any = resolveClubMaster(clubName);
  if (!club || !clubSeason) return "";

  const squadKey = (window: "summer" | "winter") =>
    `${clubSeason}|||${window}|||${club.league_key}|||${club.club_key}`;

  const hasSummer = clubSquadKeySet.has(squadKey("summer"));
  const hasWinter = clubSquadKeySet.has(squadKey("winter"));

  if (!hasSummer && !hasWinter) {
    return "";
  }

  return clubUrl({
    leagueKey: club.league_key,
    clubKey: club.club_key,
    season: clubSeason as any,
  });
};

const clubLabel = (clubName: string) => {
  const club: any = resolveClubMaster(clubName);
  return club?.club_display_ja || clubName;
};

// 選手ごとのW杯招集歴
const playerKey = (row: any) =>
  `${normalize(row.name_en || row.name_ja)}|${normalize(row.birth_date)}`;

const wcAllForCountry = loadCallups().filter(
  (row: any) =>
    clean(row.competition).toUpperCase() === "WC" &&
    clean(row.country) === countryName,
);

const wcEditionsByPlayer = new Map<string, string[]>();

for (const row of wcAllForCountry) {
  const key = playerKey(row);
  const wcEdition = clean(row.edition);

  if (!wcEdition) continue;

  const editions = wcEditionsByPlayer.get(key) ?? [];

  if (!editions.includes(wcEdition)) {
    editions.push(wcEdition);
  }

  wcEditionsByPlayer.set(key, editions);
}

for (const [key, editions] of wcEditionsByPlayer) {
  editions.sort((a, b) => Number(b) - Number(a));
  wcEditionsByPlayer.set(key, editions);
}

const columns = buildNtColumns({
  isLatestView: true,
  showStats: false,
  clubHref,
  clubLabel,
  tournamentLinks: (row) => {
    const key = playerKey(row);
    const editions = wcEditionsByPlayer.get(key) ?? [];

    return editions.map((wcEdition) => ({
      label: wcEdition,
      href: `/wc/${encodeURIComponent(wcEdition)}/team/${encodeURIComponent(countryName)}/`,
    }));
  },
});

const heading = `${countryName}代表 ${formatEdition(editionKey)} 招集メンバー`;

const title = `${countryName}代表 ${formatEdition(editionKey)} 招集メンバー｜代表ウィーク`;

const description =
  `${countryName}代表の${formatEdition(editionKey)}代表ウィーク招集メンバー一覧。` +
  `背番号、ポジション、所属クラブ、監督、当期間の試合日程・結果などを掲載しています。`;
---

<BaseLayout
  title={title}
  description={description}
  bodyClass="page-nt-iw page-wc"
  bodyStyle="margin:0; font-family: system-ui;"
  showPageHeader={true}
  crumbs={[
    { label: "トップ", href: "/" },
    { label: "各国代表一覧・国際大会ポータル", href: "/nt/" },
    { label: `${countryName}代表`, href: `/nt/${teamSlug}/` },
    { label: `${formatEdition(editionKey)} 招集メンバー` },
  ]}
  heading={heading}
>
  <h1 class="iw-title">{heading}</h1>

  <div class="iw-lead">
    <p>
      {countryName}代表の{
        formatEdition(editionKey)
      }代表活動について、招集メンバー・背番号・所属クラブなどを掲載しています。<br
      />
      ※背番号は決まり次第更新します（直近のものを暫定で表示）
    </p>
  </div>

  {
    latestSnapshot && (
      <div class="iw-updated">
        更新日：<span>{formatSnapshotDate(latestSnapshot)}</span>
      </div>
    )
  }

  <div class="iw-summary">
    {
      announcementDate && (
        <span>
          <strong>●発表日：</strong>
          {formatSnapshotDate(announcementDate)}
        </span>
      )
    }

    {
      iwFifaRankValue && (
        <span>
          <strong>●FIFAランク：</strong>
          {iwFifaRankValue}位
          {iwFifaRankDateLabel && `（${iwFifaRankDateLabel}時点）`}
        </span>
      )
    }

    {
      coach && (
        <span>
          <strong>●監督：</strong>
          {coach}
        </span>
      )
    }

    <span>
      <strong>●掲載人数：</strong>
      {rows.length}名
      {calledCount > 0 && `（招集：${calledCount}名）`}
    </span>
  </div>

  {
    activityMatches.length > 0 && (
      <div class="iw-matches">
        <div class="iw-matches-title">📝 当期間の試合日程・結果</div>

        <div class="iw-match-list">
          {activityMatches.map((match) => (
            <div class="iw-match-item">
              <span class="iw-match-date">⚽ {match.dateLabel}</span>　vs{" "}
              {match.opponentHref ? (
                <a href={match.opponentHref}>{match.opponentName}代表</a>
              ) : (
                <span>{match.opponentName}代表</span>
              )}
              {match.venueType === "H" && <span>（H）</span>}
              {match.venueType === "A" && <span>（A）</span>}
              {match.venueType === "N" && <span>（中立地）</span>}
              {match.score && <span>　{match.score}</span>}
              {match.note && <span>　{match.note}</span>}
            </div>
          ))}
        </div>
      </div>
    )
  }

  {
    starRows.length > 0 && (
      <section class="iw-star-block" aria-label="注目選手">
        <h2 class="iw-star-title">⭐ 注目選手</h2>

        <div class="iw-star-grid">
          {starRows.map((row: any) => (
            <div class="iw-star-card">
              <div class="iw-star-name">
                {clean(row.name_ja) || clean(row.name_en)}
                {clean(row.position_primary) && (
                  <span class="iw-star-pos">
                    （{clean(row.position_primary)}）
                  </span>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    iwLineupImageSrc && (
      <section class="iw-lineup-section" aria-label="フォーメーション例">
        <h2>👕 フォーメーション例</h2>

        <button
          type="button"
          class="iw-lineup-card"
          id="iw-lineup-open"
          aria-haspopup="dialog"
          aria-controls="iw-lineup-modal"
        >
          <div class="iw-lineup-thumb">
            <img
              src={iwLineupImageSrc}
              alt={`${countryName}代表 ${formatEdition(editionKey)} フォーメーション例`}
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="iw-lineup-copy">
            <div class="iw-lineup-title">👉 フォーメーション例を見る</div>

            {iwLineupFormation && (
              <div class="iw-lineup-note">システム：{iwLineupFormation}</div>
            )}

            <div class="iw-lineup-subnote">
              ※ 直近の試合・起用傾向をもとにした参考例です
            </div>
          </div>
        </button>

        <dialog
          class="iw-lineup-modal"
          id="iw-lineup-modal"
          aria-label={`${countryName}代表 ${formatEdition(editionKey)} フォーメーション例`}
        >
          <div class="iw-lineup-modal-inner">
            <button
              type="button"
              class="iw-lineup-close"
              id="iw-lineup-close"
              aria-label="閉じる"
            >
              ×
            </button>

            <div class="iw-lineup-modal-head">
              <div class="iw-lineup-modal-title">
                {countryName}代表 {formatEdition(editionKey)} フォーメーション例
                {iwLineupFormation ? `（${iwLineupFormation}）` : ""}
              </div>

              <div class="iw-lineup-modal-note">
                ※ 直近の試合・起用傾向をもとにした参考例です
              </div>
            </div>

            <div class="iw-lineup-modal-image">
              <img
                src={iwLineupImageSrc}
                alt={`${countryName}代表 ${formatEdition(editionKey)} フォーメーション例`}
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </dialog>
      </section>
    )
  }

  <section
    id="roster"
    class="iw-roster"
    aria-label={`${countryName}代表 ${formatEdition(editionKey)} 招集メンバー`}
  >
    <h2>👕 招集メンバー</h2>

    <RosterView {rows} {columns} rowClass={rowHighlightClass} />
  </section>

  {
    sameContinentTeams.length > 0 && (
      <section class="iw-related">
        <h2>🔍 同じ大陸の代表チームを見る</h2>

        <div class="iw-related-list">
          {sameContinentTeams.map((team) => (
            <a href={`/nt/${team.key}/`}>{team.name}代表</a>
          ))}
        </div>
      </section>
    )
  }

  <div class="iw-back">
    <a href={`/nt/${teamSlug}/`}>
      👈 {countryName}代表トップへ戻る
    </a>
  </div>

  <style is:global>
    .page-nt-iw .iw-title {
      display: block !important;
      margin: 4px 0 10px;
      color: #172033;
      font-size: 28px;
      font-weight: 500;
      line-height: 1.35;
    }

    .page-nt-iw .iw-lead {
      margin: 8px 0 14px;
      color: #475569;
      font-size: 16px;
      line-height: 1.75;
    }

    .page-nt-iw .iw-updated {
      margin: 8px 0 14px;
      text-align: right;
      font-size: 15px;
    }

    .page-nt-iw .iw-updated span {
      color: #c62828;
      font-weight: 600;
    }

    .page-nt-iw .iw-summary {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 24px;
      margin: 0 0 28px;
      padding: 12px 16px;
      border-left: 5px solid #8f1720;
      background: #f7ecee;
      color: #8f1720;
      font-size: 17px;
      line-height: 1.6;
    }

    .page-nt-iw .iw-summary strong {
      font-weight: 700;
    }

    .page-nt-iw .iw-roster {
      margin-top: 28px;
    }

    .page-nt-iw .iw-roster h2 {
      margin: 0 0 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid #9ca3af;
      color: #8f1720;
      font-size: 22px;
      font-weight: 500;
      line-height: 1.4;
    }

    .page-nt-iw .iw-back {
      margin: 28px 0 12px;
    }

    .page-nt-iw .iw-back a {
      color: var(--theme-link);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    @media (max-width: 520px) {
      .page-nt-iw .iw-title {
        font-size: 24px;
      }

      .page-nt-iw .iw-lead {
        font-size: 15px;
      }

      .page-nt-iw .iw-summary {
        display: block;
        font-size: 16px;
      }

      .page-nt-iw .iw-summary span {
        display: block;
      }

      .page-nt-iw .iw-roster h2 {
        font-size: 20px;
      }
    }

    .page-nt-iw #roster a {
      color: #2e7d32;
      font-weight: 700;
    }

    .page-nt-iw .iw-matches {
      margin: 8px 0 14px;
      padding: 10px 12px;
      border: 1px solid #d9dde3;
      border-radius: 6px;
      background: #f8fafc;
    }

    .page-nt-iw .iw-matches-title {
      margin-bottom: 5px;
      color: var(--theme-color);
      font-size: 14px;
      font-weight: 700;
    }

    .page-nt-iw .iw-match-list {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 20px;
    }

    .page-nt-iw .iw-match-item {
      font-size: 14px;
      line-height: 1.6;
      white-space: nowrap;
    }

    @media (max-width: 520px) {
      .page-nt-iw .iw-match-list {
        display: block;
      }

      .page-nt-iw .iw-match-item + .iw-match-item {
        margin-top: 3px;
      }
    }

    .page-nt-iw .iw-related {
      margin: 32px 0 20px;
      padding-top: 16px;
      border-top: 1px solid #d1d5db;
    }

    .page-nt-iw .iw-related h2 {
      margin: 0 0 12px;
      color: #8f1720;
      font-size: 18px;
