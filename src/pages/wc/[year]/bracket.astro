---
export function getStaticPaths() {
  return ["2026", "2022", "2018", "2014", "2010", "2006", "2002"].map(
    (year) => ({
      params: { year },
    }),
  );
}

const year = String(Astro.params.year ?? "").trim();
const bracketSrc = `/images/brackets/wc-${year}.svg`;
const pageTitle = `${year} FIFAワールドカップ 決勝トーナメント表`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="robots" content="noindex,follow" />
    <title>{pageTitle}</title>
  </head>

  <body>
    <main class="bracket-viewer">
      <img
        class="bracket-image"
        src={bracketSrc}
        alt={pageTitle}
      />
    </main>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html),
      :global(body) {
        width: 100%;
        height: 100%;
        margin: 0;
      }

      :global(body) {
        overflow: hidden;
        background: #fff;
      }

      .bracket-viewer {
        width: 100vw;
        height: 100vh;
        padding:
          max(8px, env(safe-area-inset-top))
          max(8px, env(safe-area-inset-right))
          max(8px, env(safe-area-inset-bottom))
          max(8px, env(safe-area-inset-left));
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
      }

      .bracket-image {
        display: block;
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
      }

      /*
       * スマホでは全体を画面内に縮めると文字が読めないため、
       * 横スクロールで大きく閲覧できるようにする。
       */
      @media (max-width: 760px) {
        :global(body) {
          overflow: auto;
        }

        .bracket-viewer {
          width: max-content;
          min-width: 100vw;
          height: auto;
          min-height: 100vh;
          align-items: flex-start;
          justify-content: flex-start;
          overflow: visible;
        }

        .bracket-image {
          width: 1500px;
          max-width: none;
          max-height: none;
        }
      }
    </style>
  </body>
</html>